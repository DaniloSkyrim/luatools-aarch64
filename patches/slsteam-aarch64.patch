+static void startStplugWatcher()
+{
+	const auto steamRoot = CConfig::findSteamRoot();
+	if (steamRoot.empty())
+	{
+		return;
+	}
+
+	const auto stplug = std::filesystem::path(steamRoot) / "config" / "stplug-in";
+	std::error_code ec;
+	if (!std::filesystem::is_directory(stplug, ec) || ec)
+	{
+		return;
+	}
+
+	s_stplugWatcher = std::make_unique<CFileWatcher>(
+		onStplugChanged,
+		IN_CREATE | IN_CLOSE_WRITE | IN_DELETE | IN_MOVED_TO | IN_MOVED_FROM);
+	if (s_stplugWatcher->addFile(stplug) == -1)
+	{
+		LOG_WARN("Failed to watch %s; stplug-in hot reload disabled\n",
+			stplug.c_str());
+		s_stplugWatcher.reset();
+		return;
+	}
+
+	if (!s_stplugWatcher->start())
+	{
+		LOG_WARN("Failed to start stplug-in watcher\n");
+		s_stplugWatcher.reset();
+	}
+}
 
