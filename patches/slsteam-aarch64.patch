+			return false;
+		}
+	}
+
+	//Every required function has to declare the size it is expected to have, so that
+	//a signature moving into a different routine can not go unnoticed
+	if (!maxSize)
+	{
+		LOG_ERROR("%s has no size window declared! Refusing to use it\n", name.c_str());
+		return false;
+	}
+
+	lm_address_t begin = LM_ADDRESS_BAD;
+	lm_size_t size = 0;
+	if (!MemHlp::getFunctionBounds(mod, address, &begin, &size))
+	{
+		LOG_ERROR("%s resolved to 0x%lx, which no unwind record covers! Refusing to use it\n", name.c_str(), address);
+		return false;
+	}
+
+	if (begin != address || size < minSize || size > maxSize)
+	{
+		LOG_ERROR
+		(
+			"%s resolved to 0x%lx, but the function there starts at 0x%lx with size 0x%lx (expected entry, size 0x%lx-0x%lx)! Refusing to use it\n",
+
+			name.c_str(),
+			address,
+			begin,
+			size,
+			minSize,
+			maxSize
+		);
+		return false;
+	}
+
+	LOG_DEBUG("%s validated: entry 0x%lx, size 0x%lx\n", name.c_str(), begin, size);
+	return true;
