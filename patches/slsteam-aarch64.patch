diff --git a/src/feats/manifestpins.hpp b/src/feats/manifestpins.hpp
new file mode 100644
index 0000000..bfe3725
--- /dev/null
+++ b/src/feats/manifestpins.hpp
@@ -0,0 +1,154 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// ManifestPins - pure container logic for the manifest-pinning feature.
+//
+// A pin locks a depot to a specific manifest gid the user has archived.
+// CConfig parses config.yaml's `ManifestPins:` map into the structured PinMap
+// and derives a flattened depot->gid index (the redirect lookup) plus a
+// locked-app set (the update lock). Kept free of YAML/globals/I/O so it is
+// host-unit-testable.
+
+#pragma once
+
+#include <cstdint>
+#include <unordered_map>
+#include <unordered_set>
+
+
+namespace ManifestPins
+{
+
+struct AppPins
+{
+	bool locked = false;
+	uint32_t buildId = 0; // pinned build NUMBER (0 = none)
+	std::unordered_map<uint32_t, uint64_t> depots; // depot -> gid
+};
+
+// appid -> its pins
+using PinMap = std::unordered_map<uint32_t, AppPins>;
+
+// Union every app's depot->gid into one index. A depot can be present in more
+// than one app after malformed or overlapping configuration. Keep a shared gid
+// when it is identical, but remove conflicting ownership from the fallback
+// index instead of letting iteration order choose a winner.
+inline std::unordered_map<uint32_t, uint64_t> flattenDepots(const PinMap& pins)
+{
+	std::unordered_map<uint32_t, uint64_t> flat;
+	std::unordered_set<uint32_t> ambiguous;
+	for (const auto& [appId, app] : pins)
+	{
+		if (!appId) continue;
+		for (const auto& [depotId, gid] : app.depots)
+		{
+			if (!depotId || !gid) continue;
+			if (ambiguous.contains(depotId)) continue;
+
+			auto [it, inserted] = flat.emplace(depotId, gid);
+			if (!inserted && it->second != gid)
+			{
+				flat.erase(it);
+				ambiguous.insert(depotId);
+			}
+		}
+	}
+	return flat;
+}
+
+inline std::unordered_set<uint32_t> lockedAppSet(const PinMap& pins)
+{
+	std::unordered_set<uint32_t> locked;
+	for (const auto& [appId, app] : pins)
+	{
+		if (!appId || !app.locked) continue;
+		for (const auto& [depotId, gid] : app.depots)
+		{
+			if (depotId && gid)
+			{
+				locked.insert(appId);
+				break;
+			}
+		}
+	}
+	return locked;
+}
+
+// Resolve a pin only within its owning app. Authoritative lookup for consumers
+// that know the app context; it never consults the flattened fallback and
+// therefore cannot cross-inherit another app's pin.
+inline uint64_t getPin(const PinMap& pins, uint32_t appId, uint32_t depotId)
+{
+	if (!appId || !depotId) return 0ULL;
+	const auto appIt = pins.find(appId);
+	if (appIt == pins.end()) return 0ULL;
+	const auto depotIt = appIt->second.depots.find(depotId);
+	return depotIt == appIt->second.depots.end() ? 0ULL : depotIt->second;
+}
+
+inline uint64_t getPinForContext(const PinMap& pins, uint32_t appId,
+                                uint32_t depotId)
+{
+	if (!appId || !depotId) return 0ULL;
+	return getPin(pins, appId, depotId);
+}
+
+inline uint64_t getPinForUniqueOwner(const PinMap& pins, uint32_t depotId)
+{
+	if (!depotId) return 0ULL;
+	uint64_t pin = 0ULL;
+	bool found = false;
+	for (const auto& [appId, app] : pins)
+	{
+		if (!appId) continue;
+		const auto depotIt = app.depots.find(depotId);
+		if (depotIt == app.depots.end() || depotIt->second == 0ULL) continue;
+		if (found) return 0ULL;
+		found = true;
+		pin = depotIt->second;
+	}
+	return found ? pin : 0ULL;
+}
+
+// Planner entries normally carry their owning app id. If a legacy client leaves
+// that field empty, only a depot with one configured owner may use a depot-only
+// fallback; ambiguous ownership is deliberately not resolved.
+inline uint64_t getPinForPlannerEntry(const PinMap& pins, uint32_t appId,
+                                      uint32_t depotId)
+{
+	return appId ? getPinForContext(pins, appId, depotId)
+	             : getPinForUniqueOwner(pins, depotId);
+}
+
+// Legacy/global lookup retained for hooks that do not have app context.
+// flattenDepots omits conflicting entries, so this fallback is safe.
+inline uint64_t getPin(const std::unordered_map<uint32_t, uint64_t>& flat,
+                       uint32_t depotId)
+{
+	if (!depotId) return 0ULL;
+	const auto it = flat.find(depotId);
+	return it == flat.end() ? 0ULL : it->second;
+}
+
+inline bool isLocked(const std::unordered_set<uint32_t>& locked,
+                     uint32_t appId)
+{
+	return locked.count(appId) != 0;
+}
+
+inline void purgeApps(PinMap& pins,
+                      const std::unordered_set<uint32_t>& dropApps)
+{
+	for (uint32_t appId : dropApps) pins.erase(appId);
+}
+
+inline void purgeOrphans(PinMap& pins,
+                         const std::unordered_set<uint32_t>& keepApps)
+{
+	for (auto it = pins.begin(); it != pins.end(); )
+	{
+		if (keepApps.count(it->first) == 0) it = pins.erase(it);
+		else ++it;
+	}
+}
+
+} // namespace ManifestPins
diff --git a/src/feats/manifeststore.cpp b/src/feats/manifeststore.cpp
new file mode 100644
index 0000000..cf2cace
--- /dev/null
+++ b/src/feats/manifeststore.cpp
@@ -0,0 +1,453 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+#include "manifeststore.hpp"
+
+#include <charconv>
+#include <filesystem>
+#include <fstream>
+#include <functional>
+#include <iterator>
+#include <mutex>
+#include <system_error>
+#include <unordered_map>
+
+
+namespace fs = std::filesystem;
+
+namespace
+{
+
+std::string manifestName(uint32_t depotId, uint64_t gid)
+{
+	return std::to_string(depotId) + "_" + std::to_string(gid) + ".manifest";
+}
+
+uint64_t gidFromName(const std::string& name, const std::string& prefix)
+{
+	if (name.rfind(prefix, 0) != 0) return 0;
+	const auto dot = name.rfind(".manifest");
+	if (dot == std::string::npos || dot + 9 != name.size()) return 0;
+	const auto gidText = name.substr(prefix.size(), dot - prefix.size());
+	if (gidText.empty()) return 0;
+	uint64_t gid = 0;
+	const auto result = std::from_chars(
+		gidText.data(), gidText.data() + gidText.size(), gid);
+	if (result.ec != std::errc{} ||
+	    result.ptr != gidText.data() + gidText.size() || gid == 0)
+	{
+		return 0;
+	}
+	return gid;
+}
+
+struct ManifestKey
+{
+	uint32_t depotId;
+	uint64_t gid;
+
+	bool operator==(const ManifestKey&) const = default;
+};
+
+struct ManifestKeyHash
+{
+	std::size_t operator()(const ManifestKey& key) const
+	{
+		return std::hash<uint64_t>{}(
+			(static_cast<uint64_t>(key.depotId) << 32) ^ key.gid);
+	}
+};
+
+std::mutex g_sizeMutex;
+std::unordered_map<ManifestKey, uint64_t, ManifestKeyHash> g_installedSizes;
+
+// Steam depot manifests are a sequence of <uint32 magic LE><uint32 len LE>
+// <payload> sections. The ContentManifestMetadata section (magic 0x1F4812BE)
+// carries cb_disk_original (field 5, uncompressed) and cb_disk_compressed
+// (field 6, download) as varints. Every length is bounds-checked.
+bool parseManifestSizes(const std::string& data, uint64_t& sizeOut,
+                        uint64_t& downloadOut)
+{
+	constexpr uint32_t kMetadataMagic = 0x1F4812BEu;
+
+	const auto readU32le = [&](std::size_t offset, uint32_t& out) -> bool {
+		if (offset + 4 > data.size()) return false;
+		out = static_cast<uint8_t>(data[offset]) |
+		      (static_cast<uint32_t>(static_cast<uint8_t>(data[offset + 1])) << 8) |
+		      (static_cast<uint32_t>(static_cast<uint8_t>(data[offset + 2])) << 16) |
+		      (static_cast<uint32_t>(static_cast<uint8_t>(data[offset + 3])) << 24);
+		return true;
+	};
+
+	std::size_t meta = std::string::npos;
+	std::size_t metaLen = 0;
+	for (std::size_t i = 0; i + 8 <= data.size();)
+	{
+		uint32_t magic = 0;
+		uint32_t len = 0;
+		if (!readU32le(i, magic) || !readU32le(i + 4, len)) break;
+		if (static_cast<uint64_t>(i) + 8 + len > data.size()) break;
+		if (magic == kMetadataMagic)
+		{
+			meta = i + 8;
+			metaLen = len;
+			break;
+		}
+		i += 8 + len;
+	}
+	if (meta == std::string::npos) return false;
+
+	const auto readVarint = [&](std::size_t& p, std::size_t end,
+	                            uint64_t& out) -> bool {
+		uint64_t value = 0;
+		int shift = 0;
+		while (p < end)
+		{
+			const uint8_t byte = static_cast<uint8_t>(data[p++]);
+			if (shift <= 63) value |= static_cast<uint64_t>(byte & 0x7F) << shift;
+			shift += 7;
+			if (!(byte & 0x80))
+			{
+				out = value;
+				return true;
+			}
+			if (shift > 70) return false;
+		}
+		return false;
+	};
+
+	const std::size_t end = meta + metaLen;
+	bool gotSize = false;
+	bool gotDownload = false;
+	for (std::size_t p = meta; p < end;)
+	{
+		uint64_t tag = 0;
+		if (!readVarint(p, end, tag)) break;
+		const uint32_t field = static_cast<uint32_t>(tag >> 3);
+		const uint32_t wire = static_cast<uint32_t>(tag & 0x7);
+		if (wire == 0)
+		{
+			uint64_t value = 0;
+			if (!readVarint(p, end, value)) break;
+			if (field == 5)
+			{
+				sizeOut = value;
+				gotSize = true;
+			}
+			else if (field == 6)
+			{
+				downloadOut = value;
+				gotDownload = true;
+			}
+		}
+		else if (wire == 2)
+		{
+			uint64_t len = 0;
+			if (!readVarint(p, end, len) || p + len > end) break;
+			p += len;
+		}
+		else if (wire == 5)
+		{
+			p += 4;
+		}
+		else if (wire == 1)
+		{
+			p += 8;
+		}
+		else
+		{
+			break;
+		}
+	}
+	return gotSize || gotDownload;
+}
+
+std::optional<uint64_t> parseInstalledSize(const fs::path& path)
+{
+	if (!ManifestStoreIO::isValidManifest(path)) return std::nullopt;
+
+	std::ifstream input(path, std::ios::binary);
+	if (!input) return std::nullopt;
+	const std::string bytes{std::istreambuf_iterator<char>(input),
+	                        std::istreambuf_iterator<char>()};
+
+	uint64_t installed = 0;
+	uint64_t download = 0;
+	if (!parseManifestSizes(bytes, installed, download) || installed == 0)
+	{
+		return std::nullopt;
+	}
+	return installed;
+}
+
+} // namespace
+
+
+namespace ManifestStore
+{
+
+std::string dir(const std::string& configDir)
+{
+	if (configDir.empty()) return {};
+	return (fs::path(configDir) / "manifests").string();
+}
+
+bool valid(const Paths& paths)
+{
+	return !paths.storeDir.empty() && !paths.depotcacheDir.empty();
+}
+
+std::size_t archiveDepot(const Paths& paths, uint32_t depotId)
+{
+	if (!valid(paths) || depotId == 0) return 0;
+
+	const fs::path depotcache(paths.depotcacheDir);
+	std::error_code ec;
+	if (!fs::is_directory(depotcache, ec) || ec) return 0;
+
+	const std::string prefix = std::to_string(depotId) + "_";
+	const fs::path store(paths.storeDir);
+	std::size_t archived = 0;
+
+	fs::directory_iterator it(
+		depotcache, fs::directory_options::skip_permission_denied, ec);
+	const fs::directory_iterator end;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		if (entry.is_regular_file(entryEc) && !entryEc)
+		{
+			const auto name = entry.path().filename().string();
+			if (gidFromName(name, prefix) &&
+			    ManifestStoreIO::isValidManifest(entry.path()))
+			{
+				const fs::path target = store / name;
+				if (!ManifestStoreIO::isValidManifest(target) &&
+				    ManifestStoreIO::atomicCopy(entry.path(), target))
+				{
+					++archived;
+				}
+			}
+		}
+
+		it.increment(ec);
+		if (ec) break;
+	}
+
+	return archived;
+}
+
+std::size_t archiveDepots(const Paths& paths,
+                          const std::vector<uint32_t>& depotIds)
+{
+	std::size_t archived = 0;
+	for (const uint32_t depotId : depotIds)
+	{
+		archived += archiveDepot(paths, depotId);
+	}
+	return archived;
+}
+
+bool archiveManifest(const Paths& paths, uint32_t depotId, uint64_t gid)
+{
+	if (!valid(paths) || depotId == 0 || gid == 0) return false;
+
+	const std::string name = manifestName(depotId, gid);
+	const fs::path source = fs::path(paths.depotcacheDir) / name;
+	const fs::path target = fs::path(paths.storeDir) / name;
+	if (!ManifestStoreIO::isValidManifest(source)) return false;
+	if (ManifestStoreIO::isValidManifest(target)) return true;
+	return ManifestStoreIO::atomicCopy(source, target);
+}
+
+bool publishDownloadedManifest(const Paths& paths, uint32_t depotId,
+                               uint64_t gid, const std::string& sourcePath)
+{
+	if (!valid(paths) || depotId == 0 || gid == 0 || sourcePath.empty())
+	{
+		return false;
+	}
+
+	const std::string name = manifestName(depotId, gid);
+	const fs::path archived = fs::path(paths.storeDir) / name;
+	const fs::path staged = fs::path(paths.depotcacheDir) / name;
+	return ManifestStoreIO::publishBestEffort(sourcePath, archived, staged).staged;
+}
+
+bool isInDepotcache(const Paths& paths, uint32_t depotId, uint64_t gid)
+{
+	if (paths.depotcacheDir.empty() || depotId == 0 || gid == 0) return false;
+	const fs::path path =
+		fs::path(paths.depotcacheDir) / manifestName(depotId, gid);
+	return ManifestStoreIO::isValidManifest(path);
+}
+
+bool isArchived(const Paths& paths, uint32_t depotId, uint64_t gid)
+{
+	if (paths.storeDir.empty() || depotId == 0 || gid == 0) return false;
+	const fs::path path = fs::path(paths.storeDir) / manifestName(depotId, gid);
+	return ManifestStoreIO::isValidManifest(path);
+}
+
+void cacheInstalledSize(uint32_t depotId, uint64_t gid, uint64_t size)
+{
+	if (depotId == 0 || gid == 0 || size == 0) return;
+	std::lock_guard<std::mutex> lock(g_sizeMutex);
+	g_installedSizes[{depotId, gid}] = size;
+}
+
+std::optional<uint64_t> installedSize(const Paths& paths, uint32_t depotId,
+                                      uint64_t gid)
+{
+	if (depotId == 0 || gid == 0) return std::nullopt;
+
+	const ManifestKey key{depotId, gid};
+	{
+		std::lock_guard<std::mutex> lock(g_sizeMutex);
+		const auto it = g_installedSizes.find(key);
+		if (it != g_installedSizes.end()) return it->second;
+	}
+
+	std::optional<uint64_t> size;
+	const auto name = manifestName(depotId, gid);
+	if (!paths.storeDir.empty())
+	{
+		size = parseInstalledSize(fs::path(paths.storeDir) / name);
+	}
+	if (!size && !paths.depotcacheDir.empty())
+	{
+		size = parseInstalledSize(fs::path(paths.depotcacheDir) / name);
+	}
+	if (size) cacheInstalledSize(depotId, gid, *size);
+	return size;
+}
+
+bool restoreToDepotcache(const Paths& paths, uint32_t depotId, uint64_t gid)
+{
+	if (!valid(paths) || depotId == 0 || gid == 0) return false;
+
+	const std::string name = manifestName(depotId, gid);
+	const fs::path source = fs::path(paths.storeDir) / name;
+	const fs::path target = fs::path(paths.depotcacheDir) / name;
+	return ManifestStoreIO::restore(source, target);
+}
+
+bool markPreferredGid(const Paths& paths, uint32_t depotId, uint64_t gid)
+{
+	if (paths.storeDir.empty() || depotId == 0 || gid == 0) return false;
+	if (!isArchived(paths, depotId, gid)) return false;
+	return ManifestStoreIO::writePreferred(paths.storeDir, depotId, gid);
+}
+
+uint64_t preferredArchivedGid(const Paths& paths, uint32_t depotId,
+                              uint64_t excludeGid)
+{
+	if (paths.storeDir.empty() || depotId == 0) return 0;
+	const uint64_t gid =
+		ManifestStoreIO::readPreferred(paths.storeDir, depotId, excludeGid);
+	return isArchived(paths, depotId, gid) ? gid : 0;
+}
+
+uint64_t bestArchivedGid(const Paths& paths, uint32_t depotId,
+                         uint64_t excludeGid)
+{
+	if (paths.storeDir.empty() || depotId == 0) return 0;
+
+	std::error_code ec;
+	const fs::path store(paths.storeDir);
+	if (!fs::is_directory(store, ec) || ec) return 0;
+
+	const std::string prefix = std::to_string(depotId) + "_";
+	uint64_t best = 0;
+	fs::file_time_type bestTime{};
+
+	fs::directory_iterator it(
+		store, fs::directory_options::skip_permission_denied, ec);
+	const fs::directory_iterator end;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		if (entry.is_regular_file(entryEc) && !entryEc)
+		{
+			const auto name = entry.path().filename().string();
+			const uint64_t gid = gidFromName(name, prefix);
+			if (gid && gid != excludeGid &&
+			    ManifestStoreIO::isValidManifest(entry.path()))
+			{
+				std::error_code timeEc;
+				const auto time = entry.last_write_time(timeEc);
+				if (!timeEc && (!best || time > bestTime))
+				{
+					best = gid;
+					bestTime = time;
+				}
+			}
+		}
+
+		it.increment(ec);
+		if (ec) break;
+	}
+
+	return best;
+}
+
+ArchivedGidIndex archivedGidIndex(const Paths& paths)
+{
+	if (paths.storeDir.empty()) return {};
+	return ManifestStoreIO::newestValidManifestGids(paths.storeDir);
+}
+
+std::size_t purgeDepots(const Paths& paths,
+                        const std::vector<uint32_t>& depotIds)
+{
+	if (paths.storeDir.empty()) return 0;
+
+	std::error_code ec;
+	const fs::path store(paths.storeDir);
+	if (!fs::is_directory(store, ec) || ec) return 0;
+
+	std::size_t removed = 0;
+	for (const uint32_t depotId : depotIds)
+	{
+		if (depotId == 0) continue;
+
+		const std::string prefix = std::to_string(depotId) + "_";
+		std::vector<fs::path> matches;
+
+		fs::directory_iterator it(
+			store, fs::directory_options::skip_permission_denied, ec);
+		const fs::directory_iterator end;
+		while (it != end)
+		{
+			const auto& entry = *it;
+			std::error_code entryEc;
+			if (entry.is_regular_file(entryEc) && !entryEc &&
+			    gidFromName(entry.path().filename().string(), prefix))
+			{
+				matches.push_back(entry.path());
+			}
+
+			it.increment(ec);
+			if (ec) break;
+		}
+
+		for (const auto& path : matches)
+		{
+			std::error_code removeEc;
+			fs::remove(path, removeEc);
+			if (!removeEc) ++removed;
+		}
+
+		std::error_code preferredEc;
+		if (fs::remove(ManifestStoreIO::preferredPath(store, depotId),
+		               preferredEc))
+		{
+			++removed;
+		}
+	}
+
+	return removed;
+}
+
+} // namespace ManifestStore
