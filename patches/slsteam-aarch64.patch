index 0000000..44c2c9e
--- /dev/null
+++ b/tools/test_manifestpins.cpp
@@ -0,0 +1,90 @@
+// Host test for the pure ManifestPins container.
+//
+/*
+Build/run without the 32-bit toolchain:
+  g++ -std=c++20 -Wall -Wextra -Wpedantic -Werror -Isrc \
+      tools/test_manifestpins.cpp -o /tmp/test_manifestpins
+  /tmp/test_manifestpins
+*/
+
+#include "feats/manifestpins.hpp"
+
+#include <cstdio>
+#include <unordered_map>
+#include <unordered_set>
+
+
+static int failures = 0;
+
+static void check(const bool ok, const char* name)
+{
+	if (!ok)
+	{
+		std::printf("FAIL %s\n", name);
+		++failures;
+	}
+}
+
+int main()
+{
+	using namespace ManifestPins;
+
+	PinMap pins;
+	pins[100].depots[10] = 1000;
+	pins[200].depots[20] = 2000;
+	pins[300].depots[30] = 3000;
+	pins[301].depots[30] = 3001; // conflicting owner for depot 30
+	pins[400].depots[40] = 4000;
+	pins[401].depots[40] = 4000; // identical shared owner
+	pins[500].locked = true;
+	pins[500].depots[50] = 5000;
+	pins[600].locked = true; // locked but no depots
+	pins[700].buildId = 70000;
+	pins[700].depots[70] = 7000;
+
+	const auto flat = flattenDepots(pins);
+	const auto flatValue = [&](uint32_t depotId, uint64_t want) {
+		const auto it = flat.find(depotId);
+		return it != flat.end() && it->second == want;
+	};
+
+	check(flatValue(10, 1000), "flatten depot 10");
+	check(flatValue(20, 2000), "flatten depot 20");
+	check(!flat.contains(30), "conflicting depot removed");
+	check(flatValue(40, 4000), "identical shared depot kept");
+	check(flatValue(50, 5000), "flatten depot 50");
+	check(flatValue(70, 7000), "flatten depot 70");
+
+	const auto locked = lockedAppSet(pins);
+	check(isLocked(locked, 500), "locked app with depots");
+	check(!isLocked(locked, 600), "locked app without depots is not locked");
+	check(!isLocked(locked, 100), "unlocked app");
+
+	check(getPin(pins, 100, 10) == 1000, "context pin");
+	check(getPin(pins, 200, 10) == 0, "pin does not cross apps");
+	check(getPinForUniqueOwner(pins, 20) == 2000, "unique owner pin");
+	check(getPinForUniqueOwner(pins, 30) == 0, "ambiguous owner rejected");
+	check(getPinForPlannerEntry(pins, 0, 20) == 2000, "planner unique fallback");
+	check(getPinForPlannerEntry(pins, 0, 30) == 0, "planner ambiguous fallback");
+	check(getPinForPlannerEntry(pins, 100, 10) == 1000, "planner app context");
+	check(getPin(flat, 10) == 1000, "flat lookup");
+	check(getPin(flat, 30) == 0, "flat ambiguous lookup");
+
+	PinMap purged = pins;
+	purgeApps(purged, {100, 200});
+	check(!purged.contains(100) && !purged.contains(200), "purgeApps");
+	check(purged.contains(300), "purgeApps keeps others");
+
+	purgeOrphans(purged, {300, 500});
+	check(purged.size() == 2, "purgeOrphans size");
+	check(purged.contains(300) && purged.contains(500), "purgeOrphans keep set");
+
+	if (failures)
+	{
+		std::printf("%d failure(s)\n", failures);
+		return 1;
+	}
+
+	std::printf("test_manifestpins: ok\n");
+	return 0;
+}
diff --git a/tools/test_manifeststore.cpp b/tools/test_manifeststore.cpp
new file mode 100644
index 0000000..e437ed3
--- /dev/null
+++ b/tools/test_manifeststore.cpp
@@ -0,0 +1,166 @@
+// Host test for the path-parameterized ManifestStore.
+/*
+Build/run without the 32-bit toolchain:
+  g++ -std=c++20 -Wall -Wextra -Wpedantic -Werror -pthread -Isrc \
+      tools/test_manifeststore.cpp src/feats/manifeststore.cpp -o /tmp/test_manifeststore
+  /tmp/test_manifeststore
+*/
+
+#include "feats/manifeststore.hpp"
+
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <vector>
+
+
+static int failures = 0;
+
+static void check(const bool ok, const char* name)
+{
+	if (!ok)
+	{
+		std::printf("FAIL %s\n", name);
+		++failures;
+	}
+}
+
+static void appendU32(std::string& out, uint32_t value)
+{
+	out.push_back(static_cast<char>(value & 0xFF));
+	out.push_back(static_cast<char>((value >> 8) & 0xFF));
+	out.push_back(static_cast<char>((value >> 16) & 0xFF));
+	out.push_back(static_cast<char>((value >> 24) & 0xFF));
+}
+
+static void appendVarint(std::string& out, uint64_t value)
+{
+	while (value >= 0x80)
+	{
+		out.push_back(static_cast<char>((value & 0x7F) | 0x80));
+		value >>= 7;
+	}
+	out.push_back(static_cast<char>(value));
+}
+
+// Minimal Steam depot manifest with a ContentManifestMetadata section carrying
+// cb_disk_original (field 5) and cb_disk_compressed (field 6).
+static std::string makeManifest(uint64_t size, uint64_t download)
+{
+	std::string payload;
+	payload.push_back(static_cast<char>((5u << 3) | 0u));
+	appendVarint(payload, size);
+	payload.push_back(static_cast<char>((6u << 3) | 0u));
+	appendVarint(payload, download);
+
+	std::string data;
+	appendU32(data, 0x71F617D0u); // framing magic checked by isValidManifest
+	appendU32(data, 0u);          // empty first section
+	appendU32(data, 0x1F4812BEu); // ContentManifestMetadata
+	appendU32(data, static_cast<uint32_t>(payload.size()));
+	data += payload;
+	return data;
+}
+
+static void writeFile(const std::filesystem::path& path, const std::string& text)
+{
+	std::ofstream out(path, std::ios::binary | std::ios::trunc);
+	out.write(text.data(), static_cast<std::streamsize>(text.size()));
+}
+
+int main()
+{
+	namespace fs = std::filesystem;
+
+	const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+	const auto root = fs::temp_directory_path() /
+		("sls_manifeststore_test_" + std::to_string(stamp));
+	const auto configDir = root / "config";
+	const auto depotcache = root / "depotcache";
+
+	std::error_code ec;
+	fs::create_directories(configDir, ec);
+	fs::create_directories(depotcache, ec);
+	if (ec)
+	{
+		std::printf("FAIL create temp dirs: %s\n", ec.message().c_str());
+		return 1;
+	}
+
+	ManifestStore::Paths paths;
+	paths.storeDir = ManifestStore::dir(configDir.string());
+	paths.depotcacheDir = depotcache.string();
+
+	check(paths.storeDir == (configDir / "manifests").string(),
+	      "store dir layout");
+	check(ManifestStore::dir("").empty(), "empty config dir");
+	check(ManifestStore::valid(paths), "paths valid");
+
+	writeFile(depotcache / "100_111.manifest", makeManifest(1234, 1000));
+	writeFile(depotcache / "100_112.manifest", makeManifest(2345, 2000));
+
+	check(ManifestStore::isInDepotcache(paths, 100, 111),
+	      "manifest in depotcache");
+	check(!ManifestStore::isArchived(paths, 100, 111),
+	      "not archived before copy");
+
+	check(ManifestStore::archiveManifest(paths, 100, 111), "archive exact");
+	check(ManifestStore::isArchived(paths, 100, 111), "archived exact");
+	check(ManifestStore::installedSize(paths, 100, 111) == 1234ull,
+	      "installed size from manifest");
+	check(ManifestStore::bestArchivedGid(paths, 100, 0) == 111ull,
+	      "best archived gid");
+	check(ManifestStore::markPreferredGid(paths, 100, 111),
+	      "mark preferred");
+	check(ManifestStore::preferredArchivedGid(paths, 100, 0) == 111ull,
+	      "read preferred");
+
+	const auto index = ManifestStore::archivedGidIndex(paths);
+	const auto found = index.find(100);
+	check(found != index.end() && found->second == 111ull,
+	      "archived gid index");
+
+	fs::remove(depotcache / "100_111.manifest", ec);
+	check(!ManifestStore::isInDepotcache(paths, 100, 111),
+	      "depotcache purged");
+	check(ManifestStore::restoreToDepotcache(paths, 100, 111),
+	      "restore to depotcache");
+	check(ManifestStore::isInDepotcache(paths, 100, 111),
+	      "restored file present");
+
+	const auto download = root / "downloaded.manifest";
+	writeFile(download, makeManifest(2222, 1800));
+	check(ManifestStore::publishDownloadedManifest(
+	          paths, 200, 222, download.string()),
+	      "publish downloaded");
+	check(ManifestStore::isArchived(paths, 200, 222), "published archived");
+	check(ManifestStore::isInDepotcache(paths, 200, 222),
+	      "published staged");
+	check(ManifestStore::installedSize(paths, 200, 222) == 2222ull,
+	      "published installed size");
+
+	check(ManifestStore::archiveDepot(paths, 100) == 1,
+	      "archiveDepot counts new files");
+	check(ManifestStore::isArchived(paths, 100, 112),
+	      "archiveDepot archived second file");
+
+	check(ManifestStore::purgeDepots(paths, { 100 }) == 3,
+	      "purge removes two manifests and the marker");
+	check(!ManifestStore::isArchived(paths, 100, 111), "purged 111");
+	check(!ManifestStore::isArchived(paths, 100, 112), "purged 112");
+	check(ManifestStore::preferredArchivedGid(paths, 100, 0) == 0,
+	      "purged preferred");
+
+	fs::remove_all(root, ec);
+
+	if (failures)
+	{
+		std::printf("%d failure(s)\n", failures);
+		return 1;
+	}
+
+	std::printf("test_manifeststore: ok\n");
+	return 0;
+}
