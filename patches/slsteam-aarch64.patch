+void MemHlp::flushInstructionCache(const lm_address_t address, const size_t size)
+{
+#if SLS_ARCH_ARM64
+	if (!size)
+	{
+		return;
+	}
+
+	__builtin___clear_cache(reinterpret_cast<char*>(address), reinterpret_cast<char*>(address + size));
+#else
+	(void)address;
+	(void)size;
+#endif
+}
+
+#if SLS_ARCH_ARM64
+static int64_t signExtend64(const uint64_t value, const unsigned int bits)
+{
+	const uint64_t mask = 1ULL << (bits - 1);
+	return static_cast<int64_t>((value ^ mask) - mask);
+}
+#endif
+
+bool MemHlp::relocateArm64Trampoline(const lm_address_t from, const lm_address_t trampoline, const size_t size)
+{
+#if !SLS_ARCH_ARM64
+	(void)from;
+	(void)trampoline;
+	(void)size;
+	return true;
+#else
+	if (!size || (size % sizeof(uint32_t)) != 0)
+	{
+		return false;
+	}
+
+	auto words = std::vector<uint32_t>();
+	words.resize(size / sizeof(uint32_t));
+
+	if (!LM_ReadMemory(trampoline, reinterpret_cast<lm_byte_t*>(words.data()), size))
+	{
+		LOG_ERROR("Failed to read trampoline at 0x%lx!\n", trampoline);
+		return false;
+	}
+
+	for (unsigned int i = 0; i < words.size(); i++)
+	{
+		const lm_address_t origPC = from + i * sizeof(uint32_t);
+		const lm_address_t trampPC = trampoline + i * sizeof(uint32_t);
+		const uint32_t word = words[i];
+
+		//ADRP
+		if ((word & 0x9F000000) == 0x90000000)
+		{
+			const int64_t imm =
+			(
+				signExtend64(((word >> 5) & 0x7FFFF) << 2 | ((word >> 29) & 3), 21)
+				<< 12
+			);
+
+			const int64_t origPage = (origPC & ~static_cast<lm_address_t>(0xFFF)) + imm;
+			const int64_t delta = origPage - (trampPC & ~static_cast<lm_address_t>(0xFFF));
+
+			if ((delta & 0xFFF) != 0)
+			{
+				LOG_ERROR("Unaligned ADRP page delta at 0x%lx!\n", origPC);
+				return false;
+			}
+
+			const int64_t pageDelta = delta >> 12;
+			if (pageDelta < -(1 << 20) || pageDelta >= (1 << 20))
+			{
+				LOG_ERROR("ADRP at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] =
+			(
+				(word & 0x9F00001F)
+				| ((static_cast<uint32_t>(pageDelta) & 3) << 29)
+				| ((static_cast<uint32_t>(pageDelta >> 2) & 0x7FFFF) << 5)
+			);
+			continue;
+		}
+
+		//ADR
+		if ((word & 0x9F000000) == 0x10000000)
+		{
+			const int64_t imm = signExtend64(((word >> 5) & 0x7FFFF) << 2 | ((word >> 29) & 3), 21);
+			const int64_t target = origPC + imm;
+			if (target >= static_cast<int64_t>(from) && target < static_cast<int64_t>(from + size))
+			{
+				LOG_ERROR("ADR at 0x%lx points into the displaced prologue!\n", origPC);
+				return false;
+			}
+
+			const int64_t delta = target - trampPC;
+
+			if (delta < -(1 << 20) || delta >= (1 << 20))
+			{
+				LOG_ERROR("ADR at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] =
+			(
+				(word & 0x9F00001F)
+				| ((static_cast<uint32_t>(delta) & 3) << 29)
+				| ((static_cast<uint32_t>(delta >> 2) & 0x7FFFF) << 5)
+			);
+			continue;
+		}
+
+		//B / BL
+		if ((word & 0xFC000000) == 0x14000000 || (word & 0xFC000000) == 0x94000000)
+		{
+			lm_address_t target = origPC + (signExtend64(word & 0x3FFFFFF, 26) << 2);
+			if (target >= from && target < from + size)
+			{
+				target = trampoline + (target - from);
+			}
+
+			const int64_t rel = static_cast<int64_t>(target) - static_cast<int64_t>(trampPC);
+			const int64_t delta = rel >> 2;
+
+			if
+			(
+				(rel & 3) != 0
+				|| delta < -(1 << 25)
+				|| delta >= (1 << 25)
+			)
+			{
+				LOG_ERROR("Branch at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] = (word & 0xFC000000) | (static_cast<uint32_t>(delta) & 0x3FFFFFF);
+			continue;
+		}
+
+		//B.cond and BC.cond (FEAT_HBC, bit 4 set)
+		if ((word & 0xFF000010) == 0x54000000 || (word & 0xFF000010) == 0x54000010)
+		{
+			lm_address_t target = origPC + (signExtend64((word >> 5) & 0x7FFFF, 19) << 2);
+			if (target >= from && target < from + size)
+			{
+				target = trampoline + (target - from);
+			}
+
+			const int64_t delta = (static_cast<int64_t>(target) - static_cast<int64_t>(trampPC)) >> 2;
+			if (delta < -(1 << 18) || delta >= (1 << 18))
+			{
+				LOG_ERROR("Conditional branch at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] = (word & 0xFF00001F) | ((static_cast<uint32_t>(delta) & 0x7FFFF) << 5);
+			continue;
+		}
+
+		//CBZ / CBNZ
+		if ((word & 0x7E000000) == 0x34000000)
+		{
+			lm_address_t target = origPC + (signExtend64((word >> 5) & 0x7FFFF, 19) << 2);
+			if (target >= from && target < from + size)
+			{
+				target = trampoline + (target - from);
+			}
+
+			const int64_t delta = (static_cast<int64_t>(target) - static_cast<int64_t>(trampPC)) >> 2;
+			if (delta < -(1 << 18) || delta >= (1 << 18))
+			{
+				LOG_ERROR("CBZ at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] = (word & 0xFF00001F) | ((static_cast<uint32_t>(delta) & 0x7FFFF) << 5);
+			continue;
+		}
+
+		//TBZ / TBNZ
+		if ((word & 0x7E000000) == 0x36000000)
+		{
+			lm_address_t target = origPC + (signExtend64((word >> 5) & 0x3FFF, 14) << 2);
+			if (target >= from && target < from + size)
+			{
+				target = trampoline + (target - from);
+			}
+
+			const int64_t delta = (static_cast<int64_t>(target) - static_cast<int64_t>(trampPC)) >> 2;
+			if (delta < -(1 << 13) || delta >= (1 << 13))
+			{
+				LOG_ERROR("TBZ at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] = (word & 0xFFF8001F) | ((static_cast<uint32_t>(delta) & 0x3FFF) << 5);
+			continue;
+		}
+
+		//LDR literal (including LDRSW/PRFM variants)
+		if ((word & 0x3B000000) == 0x18000000)
+		{
+			const int64_t target = origPC + (signExtend64((word >> 5) & 0x7FFFF, 19) << 2);
+			if (target >= static_cast<int64_t>(from) && target < static_cast<int64_t>(from + size))
+			{
+				LOG_ERROR("Literal load at 0x%lx points into the displaced prologue!\n", origPC);
+				return false;
+			}
+
+			const int64_t delta = (target - trampPC) >> 2;
+
+			if (delta < -(1 << 18) || delta >= (1 << 18))
+			{
+				LOG_ERROR("Literal load at 0x%lx is out of range of trampoline 0x%lx!\n", origPC, trampoline);
+				return false;
+			}
+
+			words[i] = (word & 0xFF00001F) | ((static_cast<uint32_t>(delta) & 0x7FFFF) << 5);
+			continue;
+		}
+	}
+
+	if (!LM_WriteMemory(trampoline, reinterpret_cast<lm_byte_t*>(words.data()), size))
+	{
+		LOG_ERROR("Failed to write relocated trampoline at 0x%lx!\n", trampoline);
+		return false;
+	}
+
+	flushInstructionCache(trampoline, size);
+	return true;
+#endif
+}
+
+#if SLS_ARCH_ARM64
+static std::array<lm_byte_t, 16> makeArm64AbsoluteJump(const lm_address_t target)
+{
+	std::array<lm_byte_t, 16> payload =
+	{
+		0x51, 0x00, 0x00, 0x58, //ldr x17, #8
+		0x20, 0x02, 0x5F, 0xD6, //br x17
+		0, 0, 0, 0, 0, 0, 0, 0
+	};
+
+	memcpy(payload.data() + 8, &target, sizeof(target));
+	return payload;
+}
+#endif
+
+bool MemHlp::placeArm64Detour
+(
+	const lm_address_t from,
+	const lm_address_t to,
+	lm_address_t* trampolineOut,
+	size_t* sizeOut,
+	lm_byte_t* originalOut,
+	const size_t originalOutSize,
+	const bool allowWideJump
+)
+{
+#if !SLS_ARCH_ARM64
+	(void)from;
+	(void)to;
+	(void)trampolineOut;
+	(void)sizeOut;
+	(void)originalOut;
+	(void)originalOutSize;
+	(void)allowWideJump;
+	return false;
+#else
+	if (!from || !to || !trampolineOut || !sizeOut || !originalOut)
+	{
+		return false;
+	}
+
+	const int64_t rel = static_cast<int64_t>(to) - static_cast<int64_t>(from);
+	const bool shortJump = (rel & 3) == 0 && rel >= -(1LL << 27) && rel < (1LL << 27);
+	if (!shortJump && !allowWideJump)
+	{
+		LOG_ERROR("The hook target 0x%lx is too far from 0x%lx for an atomic arm64 patch!\n", to, from);
+		return false;
+	}
+
+	if (!shortJump)
+	{
+		LOG_WARN("Using the non-atomic 16-byte arm64 patch at 0x%lx (hook 0x%lx)!\n", from, to);
+	}
+
+	const size_t minSize = shortJump ? 4 : 16;
+	const size_t aligned = LM_CodeLength(from, minSize);
+	if (!aligned || aligned > 16)
+	{
+		LOG_ERROR("Could not determine the arm64 hook size at 0x%lx!\n", from);
+		return false;
+	}
+
+	if (originalOutSize < aligned)
+	{
+		LOG_ERROR("The arm64 original-byte buffer is too small for 0x%lx!\n", from);
+		return false;
+	}
+
+	const size_t trampSize = aligned + 16;
+	const lm_address_t tramp = LM_AllocMemory(trampSize, LM_PROT_XRW);
+	if (tramp == LM_ADDRESS_BAD)
+	{
+		LOG_ERROR("Could not allocate the arm64 trampoline for 0x%lx!\n", from);
+		return false;
+	}
+
+	std::array<lm_byte_t, 16> original = {};
+	if
+	(
+		LM_ReadMemory(from, original.data(), aligned) != aligned
+		|| LM_WriteMemory(tramp, original.data(), aligned) != aligned
+	)
+	{
+		LOG_ERROR("Could not copy the arm64 prologue at 0x%lx!\n", from);
+		LM_FreeMemory(tramp, trampSize);
+		return false;
+	}
+
+	memcpy(originalOut, original.data(), aligned);
+
+	if (!relocateArm64Trampoline(from, tramp, aligned))
+	{
+		LOG_ERROR("Could not relocate the arm64 trampoline for 0x%lx!\n", from);
+		LM_FreeMemory(tramp, trampSize);
+		return false;
+	}
+
+	const auto jumpBack = makeArm64AbsoluteJump(from + aligned);
+	if (LM_WriteMemory(tramp + aligned, jumpBack.data(), jumpBack.size()) != jumpBack.size())
+	{
+		LOG_ERROR("Could not write the arm64 trampoline jump back for 0x%lx!\n", from);
+		LM_FreeMemory(tramp, trampSize);
+		return false;
+	}
+
+	flushInstructionCache(tramp, trampSize);
+
+	std::array<lm_byte_t, 16> hook = {};
+	if (shortJump)
+	{
+		const uint32_t branch = 0x14000000 | (static_cast<uint32_t>(rel >> 2) & 0x3FFFFFF);
+		memcpy(hook.data(), &branch, sizeof(branch));
+	}
+	else
+	{
+		hook = makeArm64AbsoluteJump(to);
+	}
+
+	lm_prot_t oldProt;
+	if (!LM_ProtMemory(from, aligned, LM_PROT_XRW, &oldProt))
+	{
+		LOG_ERROR("Could not unprotect the arm64 hook target at 0x%lx!\n", from);
+		LM_FreeMemory(tramp, trampSize);
+		return false;
+	}
+
+	bool written = false;
+	if (aligned == sizeof(uint32_t))
+	{
+		//Single aligned 32 bit store: safe while other threads execute the
+		//function. LM_WriteMemory is a memcpy and does not guarantee that.
+		uint32_t word = 0;
+		memcpy(&word, hook.data(), sizeof(word));
+		__atomic_store_n(reinterpret_cast<uint32_t*>(from), word, __ATOMIC_RELEASE);
+		written = true;
+	}
+	else
+	{
+		written = LM_WriteMemory(from, hook.data(), aligned) == aligned;
+	}
+
+	if (!LM_ProtMemory(from, aligned, oldProt, nullptr))
+	{
+		LOG_ERROR("Failed to restore protection at 0x%lx!\n", from);
+	}
+
+	if (!written)
+	{
+		LOG_ERROR("Could not write the arm64 hook at 0x%lx!\n", from);
+
+		//Best effort: put the original bytes back before dropping the trampoline.
+		lm_prot_t restoreProt;
+		if (LM_ProtMemory(from, aligned, LM_PROT_XRW, &restoreProt))
+		{
+			LM_WriteMemory(from, original.data(), aligned);
+			LM_ProtMemory(from, aligned, restoreProt, nullptr);
+			flushInstructionCache(from, aligned);
+		}
+
+		LM_FreeMemory(tramp, trampSize);
+		return false;
+	}
+
+	flushInstructionCache(from, aligned);
+
+	*trampolineOut = tramp;
+	*sizeOut = aligned;
+
+	LOG_DEBUG
+	(
+		"Placed arm64 detour 0x%lx -> 0x%lx (size %zu, trampoline 0x%lx, %s)\n",
+		from,
+		to,
+		aligned,
+		tramp,
+		shortJump ? "branch" : "absolute"
+	);
+
+	return true;
+#endif
+}
