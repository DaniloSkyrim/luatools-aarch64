+uint64_t parseUnsignedNode(const YAML::Node& node)
+{
+	if (!node || !node.IsScalar()) return 0;
+	const auto text = node.Scalar();
+	if (text.empty()) return 0;
+
+	uint64_t value = 0;
+	const auto result = std::from_chars(
+		text.data(), text.data() + text.size(), value);
+	if (result.ec != std::errc{} ||
+	    result.ptr != text.data() + text.size())
+	{
+		return 0;
+	}
+	return value;
+}
+
+uint32_t parseU32Node(const YAML::Node& node)
+{
+	const auto value = parseUnsignedNode(node);
+	return value <= 0xFFFFFFFFull ? static_cast<uint32_t>(value) : 0;
+}
+
+ManifestPins::PinMap parseManifestPinsNode(const YAML::Node& node)
+{
+	ManifestPins::PinMap pins;
+	if (!node || !node.IsMap()) return pins;
+
+	for (const auto& appEntry : node)
+	{
+		const auto appId = parseU32Node(appEntry.first);
+		if (!appId) continue;
+
+		ManifestPins::AppPins entry;
+		const auto body = appEntry.second;
+		if (body && body.IsMap())
+		{
+			if (body["locked"])
+			{
+				try
+				{
+					entry.locked = body["locked"].as<bool>();
+				}
+				catch (...)
+				{
+				}
+			}
+
+			if (body["buildId"])
+			{
+				entry.buildId = parseU32Node(body["buildId"]);
+			}
+
+			const auto depots = body["depots"];
+			if (depots && depots.IsMap())
+			{
+				for (const auto& depotEntry : depots)
+				{
+					const auto depotId = parseU32Node(depotEntry.first);
+					const auto gid = parseUnsignedNode(depotEntry.second);
+					if (depotId && gid)
+					{
+						entry.depots[depotId] = gid;
+					}
+				}
+			}
+		}
+
+		if (entry.locked || entry.buildId || !entry.depots.empty())
+		{
+			pins[appId] = entry;
+		}
+	}
+
+	return pins;
+}
+
