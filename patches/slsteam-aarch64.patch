+void Apps::injectManagedDepots(const AppId_t appId, CUtlVector<DepotInfo_t>* depots)
+{
+	if (!depots || appId == 0 || !g_config.isAddedAppId(appId))
+	{
+		return;
+	}
+
+	const auto configDir = g_config.getDir().string();
+	if (configDir.empty())
+	{
+		return;
+	}
+
+	const auto depotIds = DepotKey::managedDepotsForApp(configDir, appId);
+	if (depotIds.empty())
+	{
+		return;
+	}
+
+	const auto depotBlacklist = g_config.depotBlacklist.get();
+	const auto manifestPins = g_config.manifestPins.get();
+	const auto storePaths = getManifestStorePaths();
+	const bool storeReady = ManifestStore::valid(storePaths);
+
+	unsigned int injected = 0;
+	for (const auto depotId : depotIds)
+	{
+		if (depotBlacklist->contains(depotId))
+		{
+			continue;
+		}
+
+		bool alreadyListed = false;
+		for (unsigned int i = 0; i < depots->size; i++)
+		{
+			const auto listed = depots->at(i);
+			if (listed && listed->depotId == depotId)
+			{
+				alreadyListed = true;
+				break;
+			}
+		}
+
+		if (alreadyListed)
+		{
+			continue;
+		}
+
+		uint64_t manifestId =
+			ManifestPins::getPinForPlannerEntry(*manifestPins, appId, depotId);
+		if (!manifestId)
+		{
+			manifestId = ManifestId::getPin(configDir, depotId);
+		}
+		if (!manifestId && storeReady)
+		{
+			manifestId = ManifestStore::preferredArchivedGid(storePaths, depotId, 0);
+		}
+		if (!manifestId && storeReady)
+		{
+			manifestId = ManifestStore::bestArchivedGid(storePaths, depotId, 0);
+		}
+
+		//A depot without a known manifest id cannot be planned; Steam would
+		//ask the content server, which has no license for this app.
+		if (!manifestId)
+		{
+			LOG_WARN("No manifest for managed depot %u of %u; skipping\n",
+				depotId, appId);
+			continue;
+		}
+
+		const uint32_t needed = depots->size + 1;
+		if (depots->mem.alloc < needed)
+		{
+			const uint32_t newAlloc = needed + 8;
+			auto* base = reinterpret_cast<DepotInfo_t*>(
+				Steam::Plat_Realloc(depots->mem.base,
+					static_cast<int>(sizeof(DepotInfo_t) * newAlloc)));
+			if (!base)
+			{
+				break;
+			}
+
+			depots->mem.base = base;
+			depots->mem.alloc = newAlloc;
+			if (!depots->mem.growSize)
+			{
+				depots->mem.growSize = 8;
+			}
+		}
+
+		DepotInfo_t entry { };
+		entry.depotId = depotId;
+		entry.appId = appId;
+		entry.manifestId = manifestId;
+		depots->mem.base[depots->size] = entry;
+		depots->size = needed;
+		injected++;
+	}
+
+	if (injected)
+	{
+		LOG_INFO("Injected %u managed depots for %u\n", injected, appId);
+	}
+}
