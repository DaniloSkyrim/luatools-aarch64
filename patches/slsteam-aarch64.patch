index 0000000..d9e0fb5
--- /dev/null
+++ b/tools/steamrt-analyzer/analyze.py
@@ -0,0 +1,435 @@
+#!/usr/bin/env python3
+"""Offline analyser for Steam client steamclient.so builds.
+
+Reproduces the two passes SLSsteam runs at load time:
+
+  1. collect strings from the read only sections and rebuild the VFTable map
+     from .data.rel.ro (typeinfo name pointer at +ptr, vtable slots from +2*ptr)
+  2. resolve interface map method names by looking for string references inside
+     every slot function (PIC thunks on 32 bit x86, RIP relative operands on
+     x86_64, adrp/add pairs on aarch64)
+
+This lets a new Steam client build be inspected without running Steam, which is
+what the arm64 and steamrt64 ports need.
+
+Requirements: python3 and capstone (pip install capstone)
+
+Examples:
+  python analyze.py steamclient.so
+  python analyze.py steamclient.so --strings GetServerPipe
+  python analyze.py steamclient.so --refs CheckAppOwnership
+  python analyze.py steamclient.so --vtable 20IClientAppManagerMap
+  python analyze.py steamclient.so --scan "0F B7 CA 31 C0 3B 4B"
+"""
+
+import argparse
+import collections
+import struct
+import sys
+
+try:
+    from capstone import Cs, CS_ARCH_ARM64, CS_ARCH_X86, CS_MODE_32, CS_MODE_64, CS_MODE_ARM
+    from capstone.x86 import X86_OP_MEM, X86_REG_RIP
+except ImportError:  # pragma: no cover - dependency hint only
+    print("capstone is required: pip install capstone", file=sys.stderr)
+    raise SystemExit(2)
+
+SHT_RELA = 4
+SHT_REL = 9
+SHT_SYMTAB = 2
+SHT_DYNSYM = 11
+SHF_EXECINSTR = 0x4
+PTR_SIZE = {1: 4, 2: 8}
+
+#VFTables resolved by src/vftableinfo.cpp, with the methods that matter.
+INTEREST = {
+    "14IClientUserMap": ["BLoggedOn", "BUpdateAppOwnershipTicket", "GetAppOwnershipTicketExtendedData",
+                          "GetEncryptedAppTicket", "GetLegacyCDKey", "GetSteamID",
+                          "IsUserSubscribedAppInTicket", "SetLegacyCDKey"],
+    "14IClientAppsMap": ["GetAppData", "GetAppDataSection", "GetAppType", "GetDLCCount",
+                          "BGetDLCDataByIndex", "RequestAppInfoUpdate"],
+    "20IClientAppManagerMap": ["InstallApp", "UninstallApp", "LaunchApp", "GetAppInstallState",
+                                "IsAppDlcInstalled", "BIsDlcEnabled", "GetUpdateInfo", "GetAppStateInfo",
+                                "BCanRemotePlayTogether", "GetNumLibraryFolders", "GetLibraryFolderPath",
+                                "GetLibraryFolderLabel"],
+    "15IClientUtilsMap": ["GetAppID", "GetOfflineMode"],
+    "16IClientCompatMap": ["BIsCompatLayerEnabled", "BIsCompatibilityToolEnabled",
+                            "GetCompatToolDisplayName", "GetCompatToolName", "SpecifyCompatTool"],
+    "21IClientConfigStoreMap": ["SetString"],
+    "17IClientFriendsMap": ["GetFriendGamePlayed"],
+    "23IClientRemoteStorageMap": ["IsCloudEnabledForApp"],
+}
+
+
+class Elf:
+    def __init__(self, data):
+        self.data = data
+        if data[:4] != b"\x7fELF":
+            raise ValueError("not an ELF file")
+        self.bits = 64 if data[4] == 2 else 32
+        self.arm64 = struct.unpack_from("<H", data, 0x12)[0] == 0xB7
+        self.ptr = PTR_SIZE[data[4]]
+        if self.bits == 64:
+            self.shoff, = struct.unpack_from("<Q", data, 0x28)
+            self.shentsize, self.shnum, self.shstrndx = struct.unpack_from("<HHH", data, 0x3A)
+            self._sh_fmt = "<IIQQQQIIQQ"
+        else:
+            self.shoff, = struct.unpack_from("<I", data, 0x20)
+            self.shentsize, self.shnum, self.shstrndx = struct.unpack_from("<HHH", data, 0x2E)
+            self._sh_fmt = "<IIIIIIIIII"
+        self.sections = []
+        for i in range(self.shnum):
+            name, typ, flags, addr, offset, size, link, info, align, entsize = struct.unpack_from(
+                self._sh_fmt, data, self.shoff + i * self.shentsize)
+            self.sections.append(dict(name_off=name, type=typ, flags=flags, addr=addr,
+                                      offset=offset, size=size, link=link, entsize=entsize))
+        strtab = self.sections[self.shstrndx]
+        blob = self.section_bytes(strtab)
+        for s in self.sections:
+            s["name"] = self.cstr(blob, s["name_off"])
+
+    def cstr(self, blob, off):
+        end = blob.find(b"\0", off)
+        return blob[off:end].decode("latin1")
+
+    def section(self, name):
+        return next((s for s in self.sections if s["name"] == name), None)
+
+    def section_bytes(self, sec):
+        return self.data[sec["offset"]:sec["offset"] + sec["size"]]
+
+    def v2o(self, addr):
+        """Virtual address -> file offset. Sections carry both, and they differ."""
+        for sec in self.sections:
+            if sec["size"] and sec["addr"] <= addr < sec["addr"] + sec["size"]:
+                return sec["offset"] + (addr - sec["addr"])
+        return None
+
+    def read_ptr(self, addr):
+        off = self.v2o(addr)
+        if off is None:
+            return 0
+        return struct.unpack_from("<Q" if self.ptr == 8 else "<I", self.data, off)[0]
+
+    def relocations(self):
+        """r_offset -> addend for R_*_RELATIVE entries."""
+        out = {}
+        for sec in self.sections:
+            if sec["type"] not in (SHT_RELA, SHT_REL) or not sec["size"]:
+                continue
+            fmt = "<QQq" if self.ptr == 8 else "<IIi"
+            ent = 24 if self.ptr == 8 else 12
+            blob = self.section_bytes(sec)
+            for i in range(sec["size"] // ent):
+                r_off, r_info, r_add = struct.unpack_from(fmt, blob, i * ent)
+                #ELF32 packs the type into 8 bits, ELF64 into 32.
+                rtype = (r_info & 0xFF) if self.ptr == 4 else (r_info & 0xFFFFFFFF)
+                # R_X86_64_RELATIVE=8, R_AARCH64_RELATIVE=1027, R_386_RELATIVE=8
+                if rtype in (8, 1027):
+                    out[r_off] = r_add if sec["type"] == SHT_RELA else self.read_ptr(r_off)
+        return out
+
+
+class Analyzer:
+    def __init__(self, path):
+        self.path = path
+        self.data = open(path, "rb").read()
+        self.elf = Elf(self.data)
+        #Image bound, not file size: file offsets and virtual addresses differ.
+        self.max_addr = max((s["addr"] + s["size"] for s in self.elf.sections), default=len(self.data))
+        self.relocs = self.elf.relocations()
+        self.strings = {}
+        self.typeinfos = {}
+        self.vtables = collections.defaultdict(list)
+        self._collect_strings()
+        self._collect_vtables()
+        if self.elf.arm64:
+            self.md = Cs(CS_ARCH_ARM64, CS_MODE_ARM)
+        else:
+            mode = CS_MODE_64 if self.elf.bits == 64 else CS_MODE_32
+            self.md = Cs(CS_ARCH_X86, mode)
+        self.md.detail = True
+
+    def slot(self, addr):
+        if addr in self.relocs:
+            return self.relocs[addr]
+        return self.elf.read_ptr(addr)
+
+    def _collect_strings(self):
+        for sec in self.elf.sections:
+            if sec["type"] != 1 or not sec["size"]:
+                continue
+            if not (sec["name"].startswith(".rodata") or sec["name"] in (".data.rel.ro", ".data.rel.ro.local")):
+                continue
+            blob = self.elf.section_bytes(sec)
+            i = 0
+            while True:
+                j = blob.find(b"\0", i)
+                if j < 0:
+                    break
+                if 4 <= j - i <= 512:
+                    try:
+                        text = blob[i:j].decode("ascii")
+                        if all(32 <= ord(c) < 127 for c in text):
+                            self.strings[sec["addr"] + i] = text
+                    except UnicodeDecodeError:
+                        pass
+                i = j + 1
+
+    def _collect_vtables(self):
+        for sec in self.elf.sections:
+            if sec["name"] not in (".data.rel.ro", ".data.rel.ro.local"):
+                continue
+            for addr in range(sec["addr"], sec["addr"] + sec["size"], self.elf.ptr):
+                value = self.slot(addr)
+                if value and value in self.strings:
+                    self.typeinfos[addr - self.elf.ptr] = self.strings[value]
+        for sec in self.elf.sections:
+            if sec["name"] not in (".data.rel.ro", ".data.rel.ro.local"):
+                continue
+            for addr in range(sec["addr"], sec["addr"] + sec["size"], self.elf.ptr):
+                value = self.slot(addr)
+                if value and value in self.typeinfos:
+                    self.vtables[self.typeinfos[value]].append(addr - self.elf.ptr)
+
+    def text(self):
+        sec = self.elf.section(".text")
+        return sec["addr"], self.elf.section_bytes(sec)
+
+    def slots(self, vtable, limit=4096):
+        out = []
+        addr = vtable + self.elf.ptr * 2
+        for _ in range(limit):
+            value = self.slot(addr)
+            if not value or value >= self.max_addr:
+                break
+            out.append(value)
+            addr += self.elf.ptr
+        return out
+
+    def string_refs_arm64(self, start, max_instructions=0x40000):
+        """Mirror of Decompiler::__parseFunction on aarch64: follows b and the taken
+        side of conditional branches, tracks adrp/adr + add pairs, stops at
+        ret/br/blr. Returns an ordered dict address -> count (order of discovery
+        does not matter, the runtime iterates an unordered_map)."""
+        text_addr, blob = self.text()
+        refs = collections.OrderedDict()
+        taken = set()
+        budget = [max_instructions]
+
+        def imm(text):
+            text = text.strip().lstrip("#")
+            neg = text.startswith("-")
+            value = int(text.lstrip("-"), 16) if text.lstrip("-").startswith("0x") else int(text.lstrip("-"))
+            return -value if neg else value
+
+        def isreg(text):
+            return len(text) > 1 and text[0] in "xw" and text[1:].isdigit()
+
+        def regnum(text):
+            return int(text[1:])
+
+        def note(value, regs, reg):
+            if value in self.strings:
+                refs[value] = refs.get(value, 0) + 1
+                regs.pop(reg, None)
+
+        def walk(addr):
+            regs = {}
+            while True:
+                budget[0] -= 1
+                if budget[0] < 0 or not (text_addr <= addr < text_addr + len(blob)):
+                    return
+                ins = next(self.md.disasm(blob[addr - text_addr:addr - text_addr + 4], addr), None)
+                if ins is None:
+                    return
+                addr += 4
+                mn = ins.mnemonic
+                ops = [o.strip() for o in ins.op_str.split(",")]
+                uncond = mn == "b"
+                cond = mn in ("cbz", "cbnz", "tbz", "tbnz") or mn.startswith("b.")
+                if uncond or cond:
+                    try:
+                        target = imm(ops[-1])
+                    except ValueError:
+                        return
+                    seen = target in taken
+                    taken.add(target)
+                    if uncond:
+                        if seen:
+                            return
+                        addr = target
+                    elif not seen:
+                        walk(target)
+                    regs.clear()
+                    continue
+                if mn in ("ret", "br", "blr", "udf"):
+                    return
+                if mn in ("bl", "blr"):
+                    regs.clear()
+                    continue
+                if mn in ("adrp", "adr") and len(ops) >= 2 and isreg(ops[0]):
+                    reg = regnum(ops[0])
+                    regs[reg] = imm(ops[1])
+                    #adrp only yields the page, the add builds the real address
+                    if mn == "adr":
+                        note(regs[reg], regs, reg)
+                elif mn == "mov" and len(ops) >= 2 and isreg(ops[0]):
+                    dst = regnum(ops[0])
+                    if isreg(ops[1]) and regnum(ops[1]) in regs:
+                        regs[dst] = regs[regnum(ops[1])]
+                        note(regs[dst], regs, dst)
+                    else:
+                        regs.pop(dst, None)
+                elif mn == "add" and len(ops) >= 3 and isreg(ops[0]) and isreg(ops[1]):
+                    dst, src = regnum(ops[0]), regnum(ops[1])
+                    try:
+                        value = imm(ops[2])
+                        if len(ops) >= 4 and ops[3].startswith("lsl"):
+                            value <<= imm(ops[3][3:])
+                    except ValueError:
+                        regs.pop(dst, None)
+                        continue
+                    if src in regs:
+                        regs[dst] = regs[src] + value
+                        note(regs[dst], regs, dst)
+                    else:
+                        regs.pop(dst, None)
+                elif ops and isreg(ops[0]):
+                    #Any other write to the destination register invalidates it
+                    if mn.startswith(("ldr", "ldp", "sub", "orr", "and", "eor", "movz", "movk", "csel", "lsl", "lsr")):
+                        regs.pop(regnum(ops[0]), None)
+
+        walk(start)
+        return refs
+
+    def string_refs(self, start, size, max_instructions=600):
+        """Strings referenced from a function body."""
+        text_addr, blob = self.text()
+        if not (text_addr <= start < text_addr + len(blob)):
+            return collections.Counter()
+        refs = collections.Counter()
+        for n, ins in enumerate(self.md.disasm(blob[start - text_addr:start - text_addr + size], start)):
+            if n > max_instructions:
+                break
+            for op in ins.operands:
+                target = None
+                if op.type == X86_OP_MEM and op.mem.base == X86_REG_RIP:
+                    target = ins.address + ins.size + op.mem.disp
+                if target is not None and target in self.strings:
+                    refs[self.strings[target]] += 1
+            if ins.mnemonic in ("ret", "jmp", "int3"):
+                break
+        return refs
+
+    def interface_table(self, name):
+        if name not in self.vtables:
+            return None
+        fns = self.slots(self.vtables[name][0])
+        table = {}
+        for index, fn in enumerate(fns):
+            if self.elf.arm64:
+                found = [self.strings[a] for a in self.string_refs_arm64(fn)]
+            else:
+                found = self.string_refs(fn, 3000)
+            for text in found:
+                if name in text:
+                    continue
+                #The runtime renames overloads with a numeric suffix instead of
+                #overwriting the first index that referenced the string.
+                key = text
+                if key in table:
+                    suffix = 2
+                    while f"{text}{suffix}" in table:
+                        suffix += 1
+                    key = f"{text}{suffix}"
+                table[key] = index
+        return fns, table
+
+    def scan(self, pattern, limit=32):
+        text_addr, blob = self.text()
+        tokens = [(-1 if t in ("?", "??") else int(t, 16)) for t in pattern.split()]
+        anchors = [i for i, t in enumerate(tokens) if t >= 0]
+        if not anchors:
+            return []
+        anchor = anchors[0]
+        needle = bytes([tokens[anchor]])
+        hits = []
+        i = 0
+        while True:
+            i = blob.find(needle, i)
+            if i < 0:
+                break
+            start = i - anchor
+            if start >= 0 and all(
+                t < 0 or (start + j < len(blob) and blob[start + j] == t)
+                for j, t in enumerate(tokens)
+            ):
+                hits.append(text_addr + start)
+                if len(hits) >= limit:
+                    break
+            i += 1
+        return hits
+
+    def refs_to_string(self, text):
+        text_addr, blob = self.text()
+        targets = {addr for addr, value in self.strings.items() if text in value}
+        hits = []
+        for ins in self.md.disasm(blob, text_addr):
+            for op in ins.operands:
+                if op.type == X86_OP_MEM and op.mem.base == X86_REG_RIP:
+                    if ins.address + ins.size + op.mem.disp in targets:
+                        hits.append((ins.address, self.strings[ins.address + ins.size + op.mem.disp]))
+        return hits
+
+
+def main():
+    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    ap.add_argument("binary")
+    ap.add_argument("--strings", metavar="TEXT", help="list strings containing TEXT")
+    ap.add_argument("--refs", metavar="TEXT", help="find code referencing a string containing TEXT")
+    ap.add_argument("--vtable", metavar="NAME", help="dump every slot of a VFTable")
+    ap.add_argument("--scan", metavar="HEX", help="count matches of a signature ('?' for wildcards)")
+    ap.add_argument("--interfaces", action="store_true", help="resolve the SLSsteam interface tables")
+    args = ap.parse_args()
+
+    a = Analyzer(args.binary)
+    elf = a.elf
+    text_addr, blob = a.text()
+    print(f"{args.binary}: ELF{elf.bits} ptr={elf.ptr} .text=[{text_addr:#x},{text_addr + len(blob):#x})")
+    print(f"  strings={len(a.strings)} typeinfos={len(a.typeinfos)} vtables={len(a.vtables)}")
+
+    if args.strings:
+        for addr, text in sorted(a.strings.items()):
+            if args.strings in text:
+                print(f"  {addr:#x} {text}")
+
+    if args.refs:
+        for addr, _ in a.refs_to_string(args.refs):
+            print(f"  {addr:#x}")
+
+    if args.vtable:
+        fns = a.slots(a.vtables[args.vtable][0]) if args.vtable in a.vtables else []
+        print(f"{args.vtable}: {len(fns)} slots @ {a.vtables[args.vtable][0]:#x}" if fns else f"{args.vtable}: not found")
+        for index, fn in enumerate(fns):
+            print(f"  {index:5} {fn:#x}")
+
+    if args.scan:
+        hits = a.scan(args.scan)
+        print(f"signature matches: {len(hits)} {[hex(h) for h in hits]}")
+
+    if args.interfaces or not any((args.strings, args.refs, args.vtable, args.scan)):
+        for name, methods in INTEREST.items():
+            result = a.interface_table(name)
+            if not result:
+                print(f"{name}: NOT FOUND")
+                continue
+            fns, table = result
+            print(f"{name}: {len(fns)} slots")
+            for method in methods:
+                hits = sorted({table[text] for text in table if text.split("(")[0].strip() == method})
+                print(f"  {method:<38} {hits[:4] if hits else 'NOT FOUND'}")
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/steamrt-analyzer/verify_arm64_patterns.py b/tools/steamrt-analyzer/verify_arm64_patterns.py
new file mode 100644
index 0000000..59639be
--- /dev/null
+++ b/tools/steamrt-analyzer/verify_arm64_patterns.py
@@ -0,0 +1,118 @@
+#!/usr/bin/env python3
+"""Check the arm64 pattern table of src/patterns.cpp against a steamclient.so.
+
+For every non optional arm64 pattern this does what Patterns::init() does at
+runtime and a bit more:
+
+  * the signature has to match exactly once in .text (4 byte aligned)
+  * the resolved address (signature + offset, or the prologue walk for
+    SigFollowMode::PrologueUpwards) has to be the entry of a function in the
+    unwind table (.eh_frame)
+  * the size of that function has to be inside the minSize/maxSize window that
+    is declared next to the pattern
+
+Usage:
+    python verify_arm64_patterns.py steamclient.so [path/to/patterns.cpp]
+
+Requires: pip install pyelftools
+Exit code is the number of failing patterns.
+"""
+
+import bisect
+import re
+import sys
+from pathlib import Path
+
+from elftools.dwarf.callframe import FDE
+from elftools.elf.elffile import ELFFile
+
+
+def load(path):
+    data = Path(path).read_bytes()
+    with open(path, "rb") as f:
+        elf = ELFFile(f)
+        text = elf.get_section_by_name(".text")
+        fdes = sorted(
+            (e.header["initial_location"], e.header["address_range"])
+            for e in elf.get_dwarf_info().EH_CFI_entries()
+            if isinstance(e, FDE)
+        )
+        text_va, text_size, text_off = text["sh_addr"], text["sh_size"], text["sh_offset"]
+    return data[text_off:text_off + text_size], text_va, fdes
+
+
+def parse_table(source):
+    source = source.replace("\r\n", "\n")
+    block = source.split("#if SLS_ARCH_ARM64", 1)[1].split("#else", 1)[0]
+    entries = []
+    for body in re.findall(r"Pattern_t\s+\w+\s*\{(.*?)\n\t*\};", block, re.S):
+        body = re.sub(r"//[^\n]*", "", body)
+        strings = re.findall(r'"([^"]*)"', body)
+        name, pattern = strings[0], strings[1]
+        mode = re.search(r"SigFollowMode::(\w+)", body).group(1)
+        prologue_match = re.search(r"std::vector<int16_t>\s*\{([^}]*)\}", body)
+        prologue = [int(x, 16) for x in prologue_match.group(1).split(",") if x.strip()] if prologue_match else []
+        window = re.search(r"false,\s*(0x[0-9A-Fa-f]+),\s*(0x[0-9A-Fa-f]+)(?:,\s*(-?\d+))?\s*$", body.strip())
+        lo, hi = (int(window.group(1), 16), int(window.group(2), 16)) if window else (0, 0)
+        offset = int(window.group(3)) if window and window.group(3) else 0
+        entries.append((name, pattern, mode, prologue, lo, hi, offset))
+    return entries
+
+
+def scan(text, pattern):
+    regex = b"".join(
+        b"." if token == "?" else re.escape(bytes([int(token, 16)]))
+        for token in pattern.split()
+    )
+    # lookahead keeps overlapping hits; only 4 byte aligned offsets can be code
+    return [m.start() for m in re.finditer(b"(?=" + regex + b")", text, re.S) if m.start() % 4 == 0]
+
+
+def main():
+    binary = sys.argv[1]
+    source = Path(sys.argv[2] if len(sys.argv) > 2 else Path(__file__).resolve().parents[2] / "src" / "patterns.cpp")
+
+    text, text_va, fdes = load(binary)
+    starts = [a for a, _ in fdes]
+
+    def fde_of(addr):
+        i = bisect.bisect_right(starts, addr) - 1
+        if i >= 0 and fdes[i][0] <= addr < fdes[i][0] + fdes[i][1]:
+            return fdes[i]
+        return None
+
+    failures = 0
+    for name, pattern, mode, prologue, lo, hi, offset in parse_table(source.read_text()):
+        if not pattern:
+            print(f"skip  {name} (optional, no signature)")
+            continue
+
+        hits = scan(text, pattern)
+        entry = None
+        if len(hits) == 1:
+            addr = text_va + hits[0]
+            if mode == "None":
+                entry = addr + offset
+            else:
+                cursor = hits[0] & ~3
+                while cursor >= 0 and entry is None:
+                    chunk = text[cursor:cursor + len(prologue)]
+                    if all(v == -1 or chunk[i] == v for i, v in enumerate(prologue)):
+                        entry = text_va + cursor
+                    cursor -= 4
+
+        fde = fde_of(entry) if entry is not None else None
+        ok = bool(fde) and fde[0] == entry and (not hi or lo <= fde[1] <= hi)
+        failures += not ok
+        print(
+            f"{'ok   ' if ok else 'FAIL '}{name}: matches={len(hits)}"
+            f" entry={hex(entry) if entry is not None else None}"
+            f" size={hex(fde[1]) if fde else None}"
+            f" window={hex(lo)}-{hex(hi)}"
+        )
+
+    sys.exit(failures)
+
+
+if __name__ == "__main__":
+    main()
diff --git a/tools/test_catalog.cpp b/tools/test_catalog.cpp
new file mode 100644
index 0000000..f747c64
--- /dev/null
+++ b/tools/test_catalog.cpp
@@ -0,0 +1,219 @@
+// Host test for the standalone depot-key and manifest-id catalogs.
+//
+/*
+Build/run without the 32-bit toolchain:
+  g++ -std=c++20 -Wall -Wextra -Wpedantic -Werror -pthread -Isrc \
+      tools/test_catalog.cpp src/feats/depotkey_catalog.cpp \
+      src/feats/manifestid_catalog.cpp -o /tmp/test_catalog
+  /tmp/test_catalog
+*/
+
+#include "feats/depotkey_catalog.hpp"
+#include "feats/depotkey_import.hpp"
+#include "feats/manifestid_catalog.hpp"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+
+static int failures = 0;
+
+static void check(const bool ok, const char* name)
+{
+	if (!ok)
+	{
+		std::printf("FAIL %s\n", name);
+		++failures;
+	}
+}
+
+static void writeFile(const std::filesystem::path& path, const std::string& text)
+{
+	std::ofstream out(path, std::ios::binary | std::ios::trunc);
+	out.write(text.data(), static_cast<std::streamsize>(text.size()));
+}
+
+static bool contains(const std::vector<uint32_t>& values, uint32_t want)
+{
+	return std::find(values.begin(), values.end(), want) != values.end();
+}
+
+int main()
+{
+	namespace fs = std::filesystem;
+
+	const auto stamp = std::chrono::steady_clock::now().time_since_epoch().count();
+	const auto root = fs::temp_directory_path() /
+		("sls_catalog_test_" + std::to_string(stamp));
+	const auto configDir = root / "config";
+	const auto stplug = root / "stplug";
+
+	std::error_code ec;
+	fs::create_directories(configDir, ec);
+	fs::create_directories(stplug, ec);
+	if (ec)
+	{
+		std::printf("FAIL create temp dirs: %s\n", ec.message().c_str());
+		return 1;
+	}
+
+	const std::string keyHex(64, 'a');
+	std::string script;
+	script += "addappid(275851, 1, \"" + keyHex + "\")\n";
+	script += "--addappid(275852, 1, \"" + std::string(64, 'b') + "\")\n";
+	script += "setManifestid(275851, \"123456789\")\n";
+	script += "setManifestid(275852, \"987654321\", 0)\n";
+	script += "--setManifestid(275853, \"111\")\n";
+	writeFile(stplug / "275850.lua", script);
+
+	const std::string config = configDir.string();
+	const std::string stplugDir = stplug.string();
+	const std::unordered_set<uint32_t> managed { 275850 };
+
+	// Depot keys.
+	const auto keys = DepotKey::importLuaScriptsDetailed(config, stplugDir, managed);
+	check(keys.imported == 1, "depotkey import count");
+	check(keys.complete, "depotkey scan complete");
+	check(keys.depots == std::unordered_set<uint32_t> { 275851 },
+	      "depotkey import depots");
+
+	const auto missingKeys = DepotKey::importLuaScriptsDetailed(
+		config, (root / "missing").string(), managed);
+	check(!missingKeys.complete, "missing stplug-in incomplete");
+	const auto noManagedKeys = DepotKey::importLuaScriptsDetailed(
+		config, stplugDir, std::unordered_set<uint32_t> {});
+	check(!noManagedKeys.complete, "empty managed set incomplete");
+
+	const auto key = DepotKey::getKey(config, 275851);
+	check(key.depotId == 275851, "key depot id");
+	check(key.appId == 275850, "key app id");
+	check(key.key.size() == 32, "key size");
+	check(key.managed, "key managed");
+	check(DepotKey::getKey(config, 275852).key.empty(),
+	      "commented key ignored");
+	check(DepotKey::isManagedDepot(config, 275851), "isManagedDepot");
+	check(DepotKey::managedDepotsForApp(config, 275850) ==
+	          std::vector<uint32_t> { 275851 },
+	      "managedDepotsForApp");
+
+	check(DepotKey::base64Decode(DepotKey::base64Encode(key.key)) == key.key,
+	      "base64 round trip");
+	check(DepotKey::hexToBytes(keyHex).size() == 32, "hexToBytes");
+
+	check(DepotKey::saveKey(config, 0, 275851, key.key, false),
+	      "sticky save");
+	check(DepotKey::getKey(config, 275851).managed,
+	      "managed flag is sticky");
+
+	// A renamed/corrupt catalog must not return another depot's key.
+	const auto cacheDir = configDir / "cache";
+	fs::create_directories(cacheDir, ec);
+	writeFile(cacheDir / "depotkey_275860.yaml",
+	          "appId: 1\ndepotId: 275861\nkey: " +
+	              DepotKey::base64Encode(std::string(32, 'q')) +
+	              "\nmanaged: true\n");
+	check(DepotKey::getKey(config, 275860).key.empty(),
+	      "mismatched depot rejected");
+
+	// Manifest pins.
+	ManifestId::AppDepotIndex index;
+	auto pins = ManifestId::importLuaScripts(config, stplugDir, managed, index);
+	check(pins.imported == 2, "manifest pin import count");
+	check(pins.complete, "manifest scan complete");
+
+	ManifestId::AppDepotIndex missingIndex;
+	const auto missingPins = ManifestId::importLuaScripts(
+		config, (root / "missing").string(), managed, missingIndex);
+	check(!missingPins.complete, "missing manifest stplug-in incomplete");
+	const auto noManagedPins = ManifestId::importLuaScripts(
+		config, stplugDir, std::unordered_set<uint32_t> {}, missingIndex);
+	check(!noManagedPins.complete, "empty managed manifest set incomplete");
+	check(ManifestId::getPin(config, 275851) == 123456789ull, "pin 275851");
+	check(ManifestId::getPin(config, 275852) == 987654321ull, "pin 275852");
+	check(ManifestId::getPin(config, 275853) == 0, "commented pin ignored");
+	check(index.depotsForApp(275850).size() == 2, "index app depots");
+
+	// Remove one pin from the script: it becomes unowned and the catalog file
+	// is retired.
+	writeFile(stplug / "275850.lua",
+	          "addappid(275851, 1, \"" + keyHex + "\")\n"
+	          "setManifestid(275851, \"123456789\")\n");
+	pins = ManifestId::importLuaScripts(config, stplugDir, managed, index);
+	check(pins.complete, "second manifest scan complete");
+	check(contains(pins.released, 275852), "released depot reported");
+	check(ManifestId::getPin(config, 275852) == 0, "released pin removed");
+	check(ManifestId::getPin(config, 275851) == 123456789ull,
+	      "kept pin survives");
+
+	// Cold orphan reconciliation: catalogs left behind by a script deleted
+	// while Steam was closed.
+	check(DepotKey::saveKey(config, 0, 275899, std::string(32, 'z'), true),
+	      "create managed orphan");
+	check(!DepotKey::getKey(config, 275899).key.empty(), "orphan present");
+	if (keys.complete) DepotKey::pruneOrphans(config, keys.depots);
+	check(DepotKey::getKey(config, 275899).key.empty(),
+	      "managed orphan pruned");
+	check(!DepotKey::getKey(config, 275851).key.empty(),
+	      "kept key survives prune");
+
+	check(DepotKey::saveKey(config, 0, 275870, std::string(32, 'r'), false),
+	      "create observed key");
+	if (keys.complete) DepotKey::pruneOrphans(config, keys.depots);
+	check(DepotKey::getKey(config, 275870).key.size() == 32,
+	      "observed key not pruned");
+
+	check(ManifestId::savePin(config, 275899, 999), "create pin orphan");
+	if (pins.complete) ManifestId::pruneOrphans(config, pins.depots);
+	check(ManifestId::getPin(config, 275899) == 0, "pin orphan pruned");
+	check(ManifestId::getPin(config, 275851) == 123456789ull,
+	      "kept pin survives prune");
+
+	// Gate contract: ready() gates retries and a bool import can fail without
+	// completing the one-shot state.
+	DepotKey::LuaScriptImportGate gate;
+	bool ready = false;
+	int calls = 0;
+	check(!gate.run([&] { return ready; }, [&] { ++calls; }),
+	      "gate not ready");
+	check(!gate.done(), "gate retryable");
+	ready = true;
+	check(!gate.run([&] { return ready; }, [&] { ++calls; return false; }),
+	      "gate import failure");
+	check(!gate.done(), "gate failure retryable");
+	check(gate.run([&] { return ready; }, [&] { ++calls; return true; }),
+	      "gate success");
+	check(gate.done(), "gate done");
+	check(!gate.run([&] { return ready; }, [&] { ++calls; }),
+	      "gate one-shot");
+
+	// Shared ownership: a depot referenced by two apps is not released when
+	// one of them drops it.
+	ManifestId::AppDepotIndex shared;
+	shared.replaceApp(1, { 10, 20 });
+	shared.replaceApp(2, { 20 });
+	const auto fromOne = shared.replaceApp(1, { 10 });
+	check(fromOne.empty(), "shared depot not released");
+	const auto fromTwo = shared.replaceApp(2, {});
+	check(contains(fromTwo, 20), "last owner releases depot");
+
+	// Purge.
+	DepotKey::purgeDepot(config, 275851);
+	check(DepotKey::getKey(config, 275851).key.empty(), "purgeDepot");
+
+	fs::remove_all(root, ec);
+
+	if (failures)
+	{
+		std::printf("%d failure(s)\n", failures);
+		return 1;
+	}
+
+	std::printf("test_catalog: ok\n");
+	return 0;
+}
diff --git a/tools/test_config_discovery.cpp b/tools/test_config_discovery.cpp
new file mode 100644
index 0000000..462b937
--- /dev/null
+++ b/tools/test_config_discovery.cpp
@@ -0,0 +1,100 @@
+// Host test for the architecture-neutral stplug-in discovery helpers.
+//
+// Build/run without the 32-bit toolchain:
+//   g++ -std=c++20 -Wall -Wextra -Wpedantic -Werror -Isrc tools/test_config_discovery.cpp -o /tmp/test_config_discovery
+//   /tmp/test_config_discovery
+
+#include "feats/config_discovery.hpp"
+
+#include <cstdio>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+
+static int failures = 0;
+
+static void check(const bool ok, const char* name)
+{
+	if (!ok)
+	{
+		std::printf("FAIL %s\n", name);
+		++failures;
+	}
+}
+
+static bool sameSet(const std::unordered_set<uint32_t>& got,
+                    const std::vector<uint32_t>& want)
+{
+	if (got.size() != want.size()) return false;
+	for (const uint32_t id : want)
+	{
+		if (!got.contains(id)) return false;
+	}
+	return true;
+}
+
+int main()
+{
+	using namespace ConfigDiscovery;
+
+	check(appIdFromScriptName("275850.lua") == 275850, "numeric stem");
+	check(appIdFromScriptName("815370.lua") == 815370, "numeric stem 2");
+	check(appIdFromScriptName("4294967295.lua") == 4294967295u, "uint32 max");
+	check(appIdFromScriptName("4294967296.lua") == 0, "uint32 overflow");
+	check(appIdFromScriptName("0.lua") == 0, "zero stem");
+	check(appIdFromScriptName("keys.lua") == 0, "non-numeric stem");
+	check(appIdFromScriptName("275850_backup.lua") == 0, "suffix stem");
+	check(appIdFromScriptName(".lua") == 0, "empty stem");
+	check(appIdFromScriptName("275850.lua.disabled") == 0, "disabled script");
+	check(appIdFromScriptName("275850.txt") == 0, "wrong extension");
+
+	check(keepDiscoveredMainApp(275850, true), "keep single-depot app");
+	check(!keepDiscoveredMainApp(0, false), "drop zero app");
+
+	{
+		const std::unordered_set<uint32_t> stplug { 1, 2, 3 };
+		const std::unordered_set<uint32_t> lua { 4 };
+		const auto selected = selectManagedSources(stplug, lua, {}, 2);
+		check(sameSet(selected.active, { 4, 1 }), "cap keeps lua override first");
+		check(selected.discovered == 4, "discovered count");
+		check(selected.ignored == 2, "ignored count");
+	}
+
+	{
+		const std::unordered_set<uint32_t> stplug { 1, 2, 3 };
+		const auto selected = selectManagedSources(stplug, {}, { 2 }, 2);
+		check(sameSet(selected.active, { 2, 1 }), "previously active outranks fill");
+	}
+
+	{
+		const std::unordered_set<uint32_t> stplug { 1, 2 };
+		const auto selected = selectManagedSources(stplug, {}, { 99 }, 8);
+		check(sameSet(selected.active, { 1, 2 }), "stale previous id dropped");
+	}
+
+	{
+		const std::unordered_set<uint32_t> fresh { 1 };
+		const std::unordered_set<uint32_t> known { 1, 2, 3 };
+		const auto recovered = recoverRacyScanDrops(
+			fresh, known, [](const uint32_t id) { return id == 2; });
+		check(recovered == std::vector<uint32_t> { 2 }, "racy scan recovery");
+	}
+
+	{
+		const std::unordered_set<uint32_t> fresh { 1 };
+		const std::unordered_set<uint32_t> known { 1, 2 };
+		const auto recovered = recoverRacyScanDrops(
+			fresh, known, [](const uint32_t) { return false; });
+		check(recovered.empty(), "real removal is not recovered");
+	}
+
+	if (failures)
+	{
+		std::printf("%d failure(s)\n", failures);
+		return 1;
+	}
+
+	std::printf("test_config_discovery: ok\n");
+	return 0;
+}
diff --git a/tools/test_manifestpins.cpp b/tools/test_manifestpins.cpp
