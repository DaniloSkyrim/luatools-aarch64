diff --git a/src/feats/manifestbind_hook.cpp b/src/feats/manifestbind_hook.cpp
new file mode 100644
index 0000000..8f51a4a
--- /dev/null
+++ b/src/feats/manifestbind_hook.cpp
@@ -0,0 +1,183 @@
+#include "manifestbind_hook.hpp"
+
+#include "../config.hpp"
+#include "../globals.hpp"
+#include "../log.hpp"
+#include "depotkey_catalog.hpp"
+#include "depotkey_scope.hpp"
+#include "manifestid_catalog.hpp"
+#include "manifestid_integration.hpp"
+#include "manifestpins.hpp"
+#include "manifeststore.hpp"
+
+
+namespace ManifestBind
+{
+
+namespace
+{
+
+ManifestStore::Paths storePaths()
+{
+	ManifestStore::Paths paths;
+
+	const auto configDir = g_config.getDir().string();
+	if (!configDir.empty())
+	{
+		paths.storeDir = ManifestStore::dir(configDir);
+	}
+
+	const auto steamRoot = CConfig::findSteamRoot();
+	if (!steamRoot.empty())
+	{
+		paths.depotcacheDir = steamRoot + "/depotcache";
+	}
+	return paths;
+}
+
+uint64_t pinFor(uint32_t appId, uint32_t depotId)
+{
+	const auto pins = g_config.manifestPins.get();
+	uint64_t pin = ManifestPins::getPinForPlannerEntry(*pins, appId, depotId);
+	if (pin)
+	{
+		return pin;
+	}
+
+	if (!ManifestIdIntegration::catalogReady.load())
+	{
+		return 0;
+	}
+
+	const auto configDir = g_config.getDir().string();
+	return configDir.empty() ? 0 : ManifestId::getPin(configDir, depotId);
+}
+
+} // namespace
+
+const char* reasonName(Reason reason)
+{
+	switch (reason)
+	{
+		case Reason::PinArchived: return "pin-archived";
+		case Reason::PinMissing: return "pin-missing";
+		case Reason::ExactRestored: return "exact-restored";
+		case Reason::PreferredFallback: return "preferred-fallback";
+		case Reason::BestFallback: return "best-fallback";
+		case Reason::PublicKept: return "public-kept";
+		case Reason::OutOfScope: return "out-of-scope";
+	}
+	return "public-kept";
+}
+
+bool inScope(uint32_t appId, uint32_t depotId, bool hasPin)
+{
+	const auto configDir = g_config.getDir().string();
+
+	const bool appIsAdded = appId != 0 && g_config.isAddedAppId(appId);
+	const bool depotIsAdded = g_config.isAddedAppId(depotId);
+	const bool keyManaged = !configDir.empty()
+		&& DepotKey::isManagedDepot(configDir, depotId);
+	//CUser::isSubscribed() is true for every managed app too (SLSsteam feeds the
+	//subscribed list), so it cannot distinguish real ownership. Only a non-managed
+	//app can hold a native license; otherwise the manifest store would turn itself
+	//off for exactly the apps it exists for.
+	bool nativeLicense = false;
+	if (!appIsAdded && appId != 0 && g_pSteamEngine)
+	{
+		const auto user = g_pSteamEngine->getUser(0);
+		if (user)
+		{
+			nativeLicense = user->isSubscribed(appId);
+		}
+	}
+
+	return DepotKey::depotInManifestScope(appIsAdded, depotIsAdded,
+		keyManaged, hasPin, nativeLicense);
+}
+
+Decision prepareGid(uint32_t appId, uint32_t depotId, uint64_t gid,
+                    bool allowPinRedirect)
+{
+	Decision decision{gid, Reason::PublicKept};
+
+	const uint64_t pin = pinFor(appId, depotId);
+
+	if (!inScope(appId, depotId, pin != 0))
+	{
+		return {gid, Reason::OutOfScope};
+	}
+
+	const auto paths = storePaths();
+	if (!ManifestStore::valid(paths) || depotId == 0)
+	{
+		return decision;
+	}
+
+	if (gid)
+	{
+		ManifestStore::archiveManifest(paths, depotId, gid);
+	}
+
+	if (pin)
+	{
+		const bool pinReady = ManifestStore::isInDepotcache(paths, depotId, pin)
+			|| ManifestStore::restoreToDepotcache(paths, depotId, pin);
+
+		// The marker means "last exact public gid". Never point it at a pin.
+		if (gid && gid != pin && ManifestStore::isArchived(paths, depotId, gid))
+		{
+			ManifestStore::markPreferredGid(paths, depotId, gid);
+		}
+
+		if (allowPinRedirect && pinReady)
+		{
+			return {pin, Reason::PinArchived};
+		}
+
+		if (!pinReady)
+		{
+			LOG_WARN("pin %llu not archived for depot %u, keeping gid %llu\n",
+				pin, depotId, gid);
+			return {gid, Reason::PinMissing};
+		}
+
+		return {gid, Reason::PinArchived};
+	}
+
+	if (!gid)
+	{
+		return decision;
+	}
+
+	if (ManifestStore::isInDepotcache(paths, depotId, gid))
+	{
+		ManifestStore::archiveManifest(paths, depotId, gid);
+		ManifestStore::markPreferredGid(paths, depotId, gid);
+		return {gid, Reason::ExactRestored};
+	}
+
+	if (ManifestStore::restoreToDepotcache(paths, depotId, gid))
+	{
+		ManifestStore::markPreferredGid(paths, depotId, gid);
+		return {gid, Reason::ExactRestored};
+	}
+
+	uint64_t fallback = ManifestStore::preferredArchivedGid(paths, depotId, gid);
+	if (fallback && ManifestStore::restoreToDepotcache(paths, depotId, fallback))
+	{
+		ManifestStore::markPreferredGid(paths, depotId, fallback);
+		return {fallback, Reason::PreferredFallback};
+	}
+
+	fallback = ManifestStore::bestArchivedGid(paths, depotId, gid);
+	if (fallback && ManifestStore::restoreToDepotcache(paths, depotId, fallback))
+	{
+		ManifestStore::markPreferredGid(paths, depotId, fallback);
+		return {fallback, Reason::BestFallback};
+	}
+
+	return decision;
+}
+
+} // namespace ManifestBind
diff --git a/src/feats/manifestbind_hook.hpp b/src/feats/manifestbind_hook.hpp
new file mode 100644
index 0000000..ed8fff5
--- /dev/null
+++ b/src/feats/manifestbind_hook.hpp
@@ -0,0 +1,38 @@
+#pragma once
+
+#include <cstdint>
+
+
+namespace ManifestBind
+{
+	enum class Reason
+	{
+		PinArchived,
+		PinMissing,
+		ExactRestored,
+		PreferredFallback,
+		BestFallback,
+		PublicKept,
+		OutOfScope,
+	};
+
+	struct Decision
+	{
+		uint64_t gid = 0;
+		Reason reason = Reason::PublicKept;
+	};
+
+	const char* reasonName(Reason reason);
+
+	// Same scope gate prepareGid uses: should the manifest store/pin machinery
+	// engage for this app/depot? False for natively licensed or unmanaged content.
+	bool inScope(uint32_t appId, uint32_t depotId, bool hasPin);
+
+	// Stage the pinned manifest (and archive the public one) before Steam's
+	// manifest acquisition check. When allowPinRedirect is false (the active
+	// ProcessDepotManifest path) the public gid is preserved; only the fallback
+	// BYld path may return the pin itself, and only when it is already staged
+	// or can be restored from the store.
+	Decision prepareGid(uint32_t appId, uint32_t depotId, uint64_t gid,
+	                    bool allowPinRedirect);
+}
diff --git a/src/feats/manifestid_catalog.cpp b/src/feats/manifestid_catalog.cpp
new file mode 100644
index 0000000..d08d837
--- /dev/null
+++ b/src/feats/manifestid_catalog.cpp
@@ -0,0 +1,324 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+
+#include "manifestid_catalog.hpp"
+
+#include "config_discovery.hpp"
+
+#include <charconv>
+#include <filesystem>
+#include <fstream>
+#include <mutex>
+#include <regex>
+#include <sstream>
+#include <system_error>
+
+
+namespace ManifestId
+{
+
+namespace
+{
+
+std::mutex g_writeMu;
+
+std::string trim(const std::string& text)
+{
+	const auto first = text.find_first_not_of(" \t\r\n");
+	if (first == std::string::npos) return {};
+	const auto last = text.find_last_not_of(" \t\r\n");
+	return text.substr(first, last - first + 1);
+}
+
+bool parseU32(const std::string& text, uint32_t& out)
+{
+	if (text.empty()) return false;
+	unsigned long long value = 0;
+	const auto result = std::from_chars(
+		text.data(), text.data() + text.size(), value);
+	if (result.ec != std::errc{} ||
+	    result.ptr != text.data() + text.size() ||
+	    value > 0xFFFFFFFFull)
+	{
+		return false;
+	}
+	out = static_cast<uint32_t>(value);
+	return true;
+}
+
+bool parseU64(const std::string& text, uint64_t& out)
+{
+	if (text.empty()) return false;
+	uint64_t value = 0;
+	const auto result = std::from_chars(
+		text.data(), text.data() + text.size(), value);
+	if (result.ec != std::errc{} ||
+	    result.ptr != text.data() + text.size() ||
+	    value == 0)
+	{
+		return false;
+	}
+	out = value;
+	return true;
+}
+
+std::string unquote(const std::string& value)
+{
+	if (value.size() >= 2)
+	{
+		const char first = value.front();
+		const char last = value.back();
+		if ((first == '"' && last == '"') || (first == '\'' && last == '\''))
+		{
+			return value.substr(1, value.size() - 2);
+		}
+	}
+	return value;
+}
+
+bool parseCatalogFile(const std::string& path, uint32_t& depotId, uint64_t& gid)
+{
+	std::ifstream input(path.c_str());
+	if (!input.is_open()) return false;
+
+	uint32_t parsedDepot = 0;
+	uint64_t parsedGid = 0;
+	std::string line;
+	while (std::getline(input, line))
+	{
+		const auto comment = line.find('#');
+		if (comment != std::string::npos) line.erase(comment);
+		line = trim(line);
+		if (line.empty() || line == "---") continue;
+
+		const auto separator = line.find(':');
+		if (separator == std::string::npos) continue;
+		const auto name = trim(line.substr(0, separator));
+		const auto value = unquote(trim(line.substr(separator + 1)));
+
+		if (name == "depotId") parseU32(value, parsedDepot);
+		else if (name == "gid") parseU64(value, parsedGid);
+	}
+
+	if (parsedDepot == 0 || parsedGid == 0) return false;
+	depotId = parsedDepot;
+	gid = parsedGid;
+	return true;
+}
+
+bool writeAtomic(const std::string& path, const std::string& data)
+{
+	const std::filesystem::path target(path);
+	std::error_code ec;
+	std::filesystem::create_directories(target.parent_path(), ec);
+	if (ec) return false;
+
+	const std::string temp = path + ".tmp";
+	{
+		std::ofstream output(temp.c_str(),
+		                     std::ios::out | std::ios::trunc | std::ios::binary);
+		if (!output.is_open()) return false;
+		output.write(data.data(), static_cast<std::streamsize>(data.size()));
+		if (!output.good())
+		{
+			output.close();
+			std::filesystem::remove(temp, ec);
+			return false;
+		}
+	}
+
+	std::filesystem::rename(temp, target, ec);
+	if (ec)
+	{
+		std::filesystem::remove(temp, ec);
+		return false;
+	}
+	return true;
+}
+
+} // namespace
+
+
+std::string catalogDir(const std::string& configDir)
+{
+	if (configDir.empty()) return {};
+	return configDir + "/cache";
+}
+
+std::string catalogPath(const std::string& configDir, uint32_t depotId)
+{
+	const auto dir = catalogDir(configDir);
+	if (dir.empty() || depotId == 0) return {};
+	return dir + "/manifestid_" + std::to_string(depotId) + ".yaml";
+}
+
+uint64_t getPin(const std::string& configDir, uint32_t depotId)
+{
+	const auto path = catalogPath(configDir, depotId);
+	if (path.empty()) return 0;
+
+	uint32_t parsedDepot = 0;
+	uint64_t gid = 0;
+	if (!parseCatalogFile(path, parsedDepot, gid)) return 0;
+	return parsedDepot == depotId ? gid : 0;
+}
+
+bool savePin(const std::string& configDir, uint32_t depotId, uint64_t gid)
+{
+	if (depotId == 0 || gid == 0) return false;
+
+	std::lock_guard<std::mutex> lock(g_writeMu);
+
+	const auto path = catalogPath(configDir, depotId);
+	if (path.empty()) return false;
+
+	uint32_t existingDepot = 0;
+	uint64_t existingGid = 0;
+	if (parseCatalogFile(path, existingDepot, existingGid) &&
+	    existingDepot == depotId && existingGid == gid)
+	{
+		return true;
+	}
+
+	std::ostringstream yaml;
+	yaml << "depotId: " << depotId << '\n';
+	yaml << "gid: \"" << gid << "\"\n";
+	return writeAtomic(path, yaml.str());
+}
+
+void retirePin(const std::string& configDir, uint32_t depotId)
+{
+	const auto path = catalogPath(configDir, depotId);
+	if (path.empty()) return;
+
+	std::lock_guard<std::mutex> lock(g_writeMu);
+	std::error_code ec;
+	std::filesystem::remove(path, ec);
+}
+
+ImportResult importLuaScripts(const std::string& configDir,
+                              const std::string& stplugDir,
+                              const std::unordered_set<uint32_t>& managedApps,
+                              AppDepotIndex& index)
+{
+	ImportResult result;
+	if (managedApps.empty()) return result;
+
+	std::error_code ec;
+	if (!std::filesystem::is_directory(stplugDir, ec) || ec) return result;
+
+	static const std::regex setManifestId(
+		"setManifestid\\s*\\(\\s*(\\d+)\\s*,\\s*\"?([0-9]+)\"?\\s*"
+		"(?:,\\s*[^)]*)?\\)"
+	);
+
+	std::filesystem::directory_iterator it(
+		stplugDir, std::filesystem::directory_options::skip_permission_denied, ec);
+	const std::filesystem::directory_iterator end;
+	bool scanOk = true;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		const bool regular = entry.is_regular_file(entryEc);
+		if (entryEc)
+		{
+			scanOk = false;
+		}
+		else if (regular && entry.path().extension().string() == ".lua")
+		{
+			const uint32_t appId =
+				ConfigDiscovery::appIdFromScriptName(entry.path().filename().string());
+			if (appId != 0 && managedApps.contains(appId))
+			{
+				std::vector<uint32_t> scriptDepots;
+				std::ifstream input(entry.path());
+				if (!input.is_open())
+				{
+					scanOk = false;
+				}
+				else
+				{
+					std::string line;
+					while (std::getline(input, line))
+					{
+						const auto comment = line.find("--");
+						if (comment != std::string::npos) line.erase(comment);
+
+						auto begin = std::sregex_iterator(
+							line.begin(), line.end(), setManifestId);
+						const auto finish = std::sregex_iterator();
+						for (auto match = begin; match != finish; ++match)
+						{
+							uint32_t depotId = 0;
+							uint64_t gid = 0;
+							if (!parseU32((*match)[1].str(), depotId)) continue;
+							if (!parseU64((*match)[2].str(), gid)) continue;
+							result.depots.insert(depotId);
+							if (savePin(configDir, depotId, gid))
+							{
+								scriptDepots.push_back(depotId);
+								++result.imported;
+							}
+						}
+					}
+					if (input.bad()) scanOk = false;
+				}
+
+				for (const uint32_t released : index.replaceApp(appId, scriptDepots))
+				{
+					retirePin(configDir, released);
+					result.released.push_back(released);
+				}
+			}
+		}
+
+		it.increment(ec);
+		if (ec)
+		{
+			scanOk = false;
+			break;
+		}
+	}
+
+	result.complete = scanOk;
+	return result;
+}
+
+void pruneOrphans(const std::string& configDir,
+                  const std::unordered_set<uint32_t>& keepDepots)
+{
+	const auto dir = catalogDir(configDir);
+	if (dir.empty()) return;
+
+	std::error_code ec;
+	if (!std::filesystem::is_directory(dir, ec) || ec) return;
+
+	static const std::regex fileRe("manifestid_(\\d+)\\.yaml");
+
+	std::lock_guard<std::mutex> lock(g_writeMu);
+	std::filesystem::directory_iterator it(
+		dir, std::filesystem::directory_options::skip_permission_denied, ec);
+	const std::filesystem::directory_iterator end;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		if (entry.is_regular_file(entryEc) && !entryEc &&
+		    std::regex_match(entry.path().filename().string(), fileRe))
+		{
+			uint32_t depotId = 0;
+			uint64_t gid = 0;
+			if (parseCatalogFile(entry.path().string(), depotId, gid) &&
+			    !keepDepots.contains(depotId))
+			{
+				std::error_code removeEc;
+				std::filesystem::remove(entry.path(), removeEc);
+			}
+		}
+
+		it.increment(ec);
+		if (ec) break;
+	}
+}
+
+} // namespace ManifestId
diff --git a/src/feats/manifestid_catalog.hpp b/src/feats/manifestid_catalog.hpp
new file mode 100644
index 0000000..8dd2222
--- /dev/null
+++ b/src/feats/manifestid_catalog.hpp
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// Manifest GID pin catalog (standalone, no client SDK/hooks).
+//
+// A LuaTools script may carry:
+//
+//     setManifestid(<depotId>, "<gid>")
+//
+// This catalog persists the pins under
+// <configDir>/cache/manifestid_<depotId>.yaml:
+//
+//     depotId: <uint32>
+//     gid: "<decimal uint64>"
+//
+// The catalog only parses scripts and stores pins. Rewriting the PICS
+// manifests block and the planner integration stay with the hook owner.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <map>
+#include <set>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+
+namespace ManifestId
+{
+
+// Tracks which stplug-in script owns each manifest pin. A depot can be
+// referenced by multiple apps, so removing one app only releases a depot when
+// no other app still owns the relation.
+class AppDepotIndex
+{
+public:
+	void add(uint32_t appId, uint32_t depotId)
+	{
+		if (appId == 0 || depotId == 0) return;
+		appDepots_[appId].insert(depotId);
+		depotApps_[depotId].insert(appId);
+	}
+
+	std::vector<uint32_t> replaceApp(uint32_t appId,
+	                                 const std::vector<uint32_t>& depots)
+	{
+		if (appId == 0) return {};
+
+		std::set<uint32_t> desired;
+		for (const uint32_t depotId : depots)
+			if (depotId != 0) desired.insert(depotId);
+
+		std::vector<uint32_t> released;
+		const auto currentIt = appDepots_.find(appId);
+		if (currentIt != appDepots_.end())
+		{
+			for (const uint32_t depotId : currentIt->second)
+			{
+				if (desired.contains(depotId)) continue;
+				auto owners = depotApps_.find(depotId);
+				if (owners == depotApps_.end())
+				{
+					released.push_back(depotId);
+					continue;
+				}
+				if (owners->second.size() == 1) released.push_back(depotId);
+				owners->second.erase(appId);
+				if (owners->second.empty()) depotApps_.erase(owners);
+			}
+		}
+
+		if (desired.empty())
+		{
+			appDepots_.erase(appId);
+			return released;
+		}
+
+		appDepots_[appId] = desired;
+		for (const uint32_t depotId : desired) depotApps_[depotId].insert(appId);
+		return released;
+	}
+
+	std::vector<uint32_t> depotsForApp(uint32_t appId) const
+	{
+		std::vector<uint32_t> out;
+		const auto it = appDepots_.find(appId);
+		if (it == appDepots_.end()) return out;
+		out.assign(it->second.begin(), it->second.end());
+		return out;
+	}
+
+	std::vector<uint32_t> exclusiveDepotsForApp(uint32_t appId) const
+	{
+		std::vector<uint32_t> out;
+		const auto it = appDepots_.find(appId);
+		if (it == appDepots_.end()) return out;
+		for (const uint32_t depotId : it->second)
+		{
+			const auto owners = depotApps_.find(depotId);
+			if (owners != depotApps_.end() && owners->second.size() == 1)
+				out.push_back(depotId);
+		}
+		return out;
+	}
+
+	std::vector<uint32_t> releaseApp(uint32_t appId)
+	{
+		const auto it = appDepots_.find(appId);
+		if (it == appDepots_.end()) return {};
+
+		const auto released = exclusiveDepotsForApp(appId);
+		for (const uint32_t depotId : it->second)
+		{
+			auto owners = depotApps_.find(depotId);
+			if (owners == depotApps_.end()) continue;
+			owners->second.erase(appId);
+			if (owners->second.empty()) depotApps_.erase(owners);
+		}
+		appDepots_.erase(it);
+		return released;
+	}
+
+private:
+	std::map<uint32_t, std::set<uint32_t>> appDepots_;
+	std::map<uint32_t, std::set<uint32_t>> depotApps_;
+};
+
+struct ImportResult
+{
+	std::size_t imported = 0;
+	// True only when the whole stplug-in scan finished without an I/O error
+	// (and managedApps was non-empty and the directory existed). Callers must
+	// gate pruneOrphans() on this: a partial scan would delete valid pins.
+	bool complete = false;
+	// Depots referenced by the current scripts. Pass this to pruneOrphans()
+	// after a complete import.
+	std::unordered_set<uint32_t> depots;
+	// Depots that no longer belong to any script and whose catalog file was
+	// removed during this import.
+	std::vector<uint32_t> released;
+};
+
+// <configDir>/cache. Does not create anything.
+std::string catalogDir(const std::string& configDir);
+
+// <configDir>/cache/manifestid_<depotId>.yaml.
+std::string catalogPath(const std::string& configDir, uint32_t depotId);
+
+// 0 when absent or malformed.
+uint64_t getPin(const std::string& configDir, uint32_t depotId);
+
+// Writes atomically (temp + rename). Rejects depotId/gid == 0.
+bool savePin(const std::string& configDir, uint32_t depotId, uint64_t gid);
+
+// Remove one catalog entry.
+void retirePin(const std::string& configDir, uint32_t depotId);
+
+// Scan <stplugDir>/*.lua, strip `--` comments, ingest every
+// setManifestid(depot, "<gid>"[, ...]) whose filename stem is in
+// `managedApps`, and reconcile `index` for that app. The accepted script
+// format is the community one; the gid may be quoted or a bare decimal.
+// `managedApps` is required: an empty set imports nothing. Released depots are
+// removed from the catalog and returned in `released`. `index` is owned by the
+// caller and is not thread-safe.
+ImportResult importLuaScripts(const std::string& configDir,
+                              const std::string& stplugDir,
+                              const std::unordered_set<uint32_t>& managedApps,
+                              AppDepotIndex& index);
+
+// Remove catalog entries whose depot is not in `keepDepots`. Reconciles a
+// script deleted while Steam was closed; the in-memory AppDepotIndex starts
+// empty each process and cannot see that removal on its own.
+// The caller must only call this after ImportResult::complete is true; with an
+// empty managedApps or a missing stplug-in directory the import is incomplete
+// and prune would delete everything.
+void pruneOrphans(const std::string& configDir,
+                  const std::unordered_set<uint32_t>& keepDepots);
+
+} // namespace ManifestId
