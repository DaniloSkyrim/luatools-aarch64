+	// Return true only when the message was modified and must be serialized
+	// back into the CNetPacket before Steam's original RecvPkt runs.
+	//
+	// Product-info MUST NOT rewrite app->buffer() or app->sha(): Steam checks
+	// the buffer against the PICS changelist SHA-1, and any edit produces
+	// "Corrupt data in text buffer". The planned strong implementation should
+	// return false for product-info (provision/archive only); pins belong in
+	// the planner/download layer.
+	bool recvProductInfoResponse(CMsgClientPICSProductInfoResponse* msg);
+	bool recvChangesSinceResponse(CMsgClientPICSChangesSinceResponse* msg);
+}
