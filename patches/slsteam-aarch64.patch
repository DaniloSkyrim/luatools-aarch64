diff --git a/tools/smoke-test.sh b/tools/smoke-test.sh
new file mode 100644
index 0000000..60c585d
--- /dev/null
+++ b/tools/smoke-test.sh
@@ -0,0 +1,201 @@
+#!/usr/bin/env bash
+# Smoke test for the native aarch64 SLSsteam build. Run it after every Steam update.
+#
+# It checks the steam.real that is running right now:
+#   * SLSsteam logged "Loaded successfully" for the current session
+#   * no pattern or hook got rejected (see the reject list below)
+#   * the steamclient.so hash is a supported one (warning only, --strict makes it fatal)
+#   * steam.real keeps running for N minutes without a segfault / new coredump
+#
+# Usage (on the device, as the Steam user):
+#   tools/smoke-test.sh [--minutes N] [--restart] [--strict] [--log FILE]
+# Usage (from another machine, runs the same script over ssh):
+#   tools/smoke-test.sh --ssh armada@192.168.2.180 [-i KEY] [other options]
+#
+#   --minutes N   how long steam.real has to survive (default 5, 0 only checks the log)
+#   --restart     restart Game Mode first (steamos-session-select desktop -> gamescope).
+#                 Do not use it while somebody else is using the device.
+#   --strict      unknown steamclient.so hash fails the test
+#   --log FILE    SLSsteam log, default ~/.SLSsteam.log
+#
+# Exit code: 0 passed, 1 failed, 2 usage error.
+
+MINUTES=5
+RESTART=0
+STRICT=0
+LOG="${HOME}/.SLSsteam.log"
+SSH_HOST=""
+SSH_KEY=""
+ARGS=("$@")
+
+while [ $# -gt 0 ]; do
+	case "$1" in
+		--minutes) MINUTES="$2"; shift 2 ;;
+		--restart) RESTART=1; shift ;;
+		--strict) STRICT=1; shift ;;
+		--log) LOG="$2"; shift 2 ;;
+		--ssh) SSH_HOST="$2"; shift 2 ;;
+		-i) SSH_KEY="$2"; shift 2 ;;
+		-h|--help) sed -n '2,24p' "$0"; exit 0 ;;
+		*) echo "unknown option $1" >&2; exit 2 ;;
+	esac
+done
+
+case "$MINUTES" in
+	''|*[!0-9]*) echo "--minutes needs a number" >&2; exit 2 ;;
+esac
+
+if [ -n "$SSH_HOST" ]; then
+	# Run this very script on the device, without the ssh options
+	REMOTE_ARGS=()
+	skip=0
+	for a in "${ARGS[@]}"; do
+		if [ "$skip" = 1 ]; then skip=0; continue; fi
+		case "$a" in
+			--ssh|-i) skip=1 ;;
+			*) REMOTE_ARGS+=("$a") ;;
+		esac
+	done
+	SSH_OPTS=(-o BatchMode=yes -o ConnectTimeout=10)
+	[ -n "$SSH_KEY" ] && SSH_OPTS+=(-i "$SSH_KEY")
+	exec ssh "${SSH_OPTS[@]}" "$SSH_HOST" bash -s -- "${REMOTE_ARGS[@]}" < "$0"
+fi
+
+FAILS=0
+pass() { echo "pass  $*"; }
+warn() { echo "warn  $*"; }
+fail() { echo "FAIL  $*"; FAILS=$((FAILS + 1)); }
+
+# Log lines that mean SLSsteam refused something or gave up. Keep in sync with
+# the messages of Pattern_t::validate(), Patterns::init(), DetourHook::verify() and Hooks::init().
+REJECT_REGEX='Refusing to use it|Refusing to hook|was not found or got rejected|is ambiguous|Hook verification failed|Failed to place all hooks|Failed to place detour|Failed to hook the interfaces|No hooks installed|Everything got rolled back|Failed to find or validate|Failed to parse VFTables|Failed to find steam exports'
+
+steam_pid() { pgrep -x steam.real | head -n 1; }
+coredumps() { command -v coredumpctl >/dev/null 2>&1 && coredumpctl list --no-pager 2>/dev/null | grep -c 'steam.real'; }
+
+# Lines of the newest steamclient.so load in the log
+session_log() {
+	local start
+	start=$(grep -n 'steamclient.so loaded from' "$LOG" 2>/dev/null | tail -n 1 | cut -d: -f1)
+	[ -z "$start" ] && return 1
+	tail -n +"$start" "$LOG"
+}
+
+restart_game_mode() {
+	export DBUS_SESSION_BUS_ADDRESS="unix:path=/run/user/$(id -u)/bus"
+	local old_pid i
+	old_pid=$(steam_pid)
+
+	echo "restarting Game Mode"
+	steamos-session-select desktop || { fail "steamos-session-select desktop failed"; return 1; }
+	for i in $(seq 1 60); do pgrep -x plasmashell >/dev/null && break; sleep 2; done
+	sleep 8
+	for i in 1 2 3; do
+		steamos-session-select gamescope && break
+		echo "gamescope switch refused, retry $i"
+		sleep 8
+	done
+
+	for i in $(seq 1 90); do
+		local pid
+		pid=$(steam_pid)
+		if [ -n "$pid" ] && [ "$pid" != "$old_pid" ]; then
+			break
+		fi
+		sleep 2
+	done
+	for i in $(seq 1 90); do
+		session_log 2>/dev/null | grep -q 'Loaded successfully' && return 0
+		sleep 2
+	done
+}
+
+[ "$RESTART" = 1 ] && restart_game_mode
+
+# --- installed library
+SO="${HOME}/.local/share/SLSsteam/SLSsteam.so"
+if [ -f "$SO" ]; then
+	pass "SLSsteam.so installed ($(sha256sum "$SO" | cut -c1-16))"
+else
+	fail "SLSsteam.so is not installed at $SO"
+fi
+
+# --- running client
+PID=$(steam_pid)
+if [ -z "$PID" ]; then
+	fail "steam.real is not running"
+	echo "FAILED ($FAILS)"
+	exit 1
+fi
+pass "steam.real running as pid $PID since $(ps -o lstart= -p "$PID" | sed 's/  */ /g')"
+
+# --- log of this session
+if [ ! -r "$LOG" ]; then
+	fail "log $LOG is missing"
+	echo "FAILED ($FAILS)"
+	exit 1
+fi
+
+SESSION=$(session_log)
+if [ -z "$SESSION" ]; then
+	fail "no 'steamclient.so loaded from' line in $LOG, SLSsteam never attached"
+else
+	if echo "$SESSION" | grep -q 'Loaded successfully'; then
+		pass "Loaded successfully"
+	else
+		fail "'Loaded successfully' missing in the current session (NotifyInit off? check the other messages)"
+	fi
+
+	REJECTED=$(echo "$SESSION" | grep -E "$REJECT_REGEX")
+	if [ -n "$REJECTED" ]; then
+		fail "patterns or hooks were rejected:"
+		echo "$REJECTED" | cut -c1-240 | sed 's/^/        /'
+	else
+		pass "no pattern or hook rejected"
+	fi
+
+	HASH=$(echo "$SESSION" | grep -o 'steamclient.so hash is [0-9a-f]*' | tail -n 1 | awk '{print $NF}')
+	if echo "$SESSION" | grep -q 'Unknown steamclient.so hash'; then
+		if [ "$STRICT" = 1 ]; then
+			fail "unknown steamclient.so hash ${HASH:-?}"
+		else
+			warn "unknown steamclient.so hash ${HASH:-?}, add it to src/supportedhashes.hpp once this test passes"
+		fi
+	elif [ -n "$HASH" ]; then
+		pass "supported steamclient.so hash $HASH"
+	else
+		warn "no steamclient.so hash in the log (old SLSsteam build?)"
+	fi
+fi
+
+if [ "$FAILS" -gt 0 ]; then
+	echo "FAILED ($FAILS)"
+	exit 1
+fi
+
+# --- stability
+if [ "$MINUTES" -gt 0 ]; then
+	BASE=$(coredumps)
+	END=$(( $(date +%s) + MINUTES * 60 ))
+	echo "watching pid $PID for $MINUTES min"
+	while [ "$(date +%s)" -lt "$END" ]; do
+		sleep 10
+		if [ "$(steam_pid)" != "$PID" ]; then
+			fail "steam.real (pid $PID) is gone or got replaced after $(( MINUTES * 60 - (END - $(date +%s)) ))s"
+			break
+		fi
+		if [ -n "$BASE" ] && [ "$(coredumps)" != "$BASE" ]; then
+			fail "new steam.real coredump while watching"
+			break
+		fi
+	done
+	[ "$FAILS" -eq 0 ] && pass "steam.real stayed up for $MINUTES min, no new coredump"
+fi
+
+if [ "$FAILS" -gt 0 ]; then
+	echo "FAILED ($FAILS)"
+	exit 1
+fi
+
+echo "PASSED"
+exit 0
