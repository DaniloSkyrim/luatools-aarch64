+#pragma once
+
+#include <cstdint>
+
+
+#if defined(__aarch64__) || defined(_M_ARM64) || defined(__arm64__)
+	#define SLS_ARCH_ARM64 1
+	#define SLS_ARCH_X86 0
+	#define SLS_ARCH_X86_64 0
+#elif defined(__x86_64__) || defined(_M_X64)
+	#define SLS_ARCH_ARM64 0
+	#define SLS_ARCH_X86 0
+	#define SLS_ARCH_X86_64 1
+#else
+	#define SLS_ARCH_ARM64 0
+	#define SLS_ARCH_X86 1
+	#define SLS_ARCH_X86_64 0
+#endif
+
+//Both 64 bit clients use 8 byte pointers and LP64 member layouts. The 32 bit
+//x86 client is the only ILP32 target.
+#define SLS_ARCH_64 (SLS_ARCH_ARM64 || SLS_ARCH_X86_64)
+
+namespace Arch
+{
+	constexpr bool isArm64()
+	{
+#if SLS_ARCH_ARM64
+		return true;
+#else
+		return false;
+#endif
+	}
+
+	constexpr bool isX86()
+	{
+#if SLS_ARCH_X86
+		return true;
+#else
+		return false;
+#endif
+	}
+
+	constexpr bool isX86_64()
+	{
+#if SLS_ARCH_X86_64
+		return true;
+#else
+		return false;
+#endif
+	}
+
+	constexpr bool is64Bit()
+	{
+		return sizeof(void*) == 8;
+	}
+}
