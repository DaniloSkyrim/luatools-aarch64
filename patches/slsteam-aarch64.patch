+		//Capstone prints decimal immediates without a 0x prefix
+		char* end = nullptr;
+		const unsigned long long dec = strtoull(imm.c_str(), &end, 10);
+		if (!end || *end != '\0')
+		{
+			return false;
+		}
+
+		value = negative ? static_cast<lm_address_t>(-static_cast<intptr_t>(dec)) : static_cast<lm_address_t>(dec);
+		return true;
+	}
+
+	if (imm.empty())
+	{
+		return false;
+	}
+
+	if (std::find_if(imm.begin(), imm.end(), [](const unsigned char c) { return !std::isxdigit(c); }) != imm.end())
+	{
+		return false;
+	}
+
+	const unsigned long long hex = strtoull(imm.c_str(), nullptr, 16);
+	value = negative ? static_cast<lm_address_t>(-static_cast<intptr_t>(hex)) : static_cast<lm_address_t>(hex);
