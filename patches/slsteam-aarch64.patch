+#if SLS_ARCH_ARM64
+static std::string trimArmOperand(const std::string& str)
+{
+	const auto begin = str.find_first_not_of(" \t");
+	if (begin == std::string::npos)
+	{
+		return "";
+	}
+
+	const auto end = str.find_last_not_of(" \t");
+	return str.substr(begin, end - begin + 1);
