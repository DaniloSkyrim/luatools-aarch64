diff --git a/src/yaml_compat.cpp b/src/yaml_compat.cpp
new file mode 100644
index 0000000..c491d27
--- /dev/null
+++ b/src/yaml_compat.cpp
@@ -0,0 +1,50 @@
+#include "yaml-cpp/emitter.h"
+#include "yaml-cpp/fptostring.h"
+
+#include <iomanip>
+#include <locale>
+#include <sstream>
+#include <string>
+
+
+//The vendored headers in include/yaml-cpp are yaml-cpp 0.8.0 plus two pieces
+//that only exist upstream on master: FpToString() and
+//Emitter::Write(const char*, size_t). The static library is built from the 0.8.0
+//tag, so both symbols are provided here instead of relying on the library.
+namespace YAML
+{
+	Emitter& Emitter::Write(const char* str, const std::size_t size)
+	{
+		return Write(std::string(str, size));
+	}
+
+	template<typename T>
+	static std::string fpToString(const T value, const std::size_t precision)
+	{
+		std::ostringstream stream;
+		stream.imbue(std::locale::classic());
+
+		if (precision)
+		{
+			stream << std::setprecision(static_cast<int>(precision));
+		}
+
+		stream << value;
+		return stream.str();
+	}
+
+	std::string FpToString(const float v, const size_t precision)
+	{
+		return fpToString(v, precision);
+	}
+
+	std::string FpToString(const double v, const size_t precision)
+	{
+		return fpToString(v, precision);
+	}
+
+	std::string FpToString(const long double v, const size_t precision)
+	{
+		return fpToString(v, precision);
+	}
+}
diff --git a/tools/build-libs-arm64.sh b/tools/build-libs-arm64.sh
new file mode 100644
index 0000000..5e6fe6a
--- /dev/null
+++ b/tools/build-libs-arm64.sh
@@ -0,0 +1,185 @@
+#!/usr/bin/env bash
+#
+# Builds the static libraries SLSsteam links into lib/arm64.
+#
+# Run this on a native aarch64 Linux host. Cross compilation works as well when
+# an aarch64-linux-gnu toolchain is installed (CROSS=aarch64-linux-gnu-).
+#
+# Valve builds the Steam runtime libraries with GCC 9 and the old libstdc++ ABI,
+# so GCC 9 is preferred here when present. SLSsteam itself links libstdc++
+# statically on aarch64, so the main binary may use a newer compiler.
+set -euo pipefail
+
+ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
+OUT="$ROOT/lib/arm64"
+BUILD="$ROOT/build/arm64"
+JOBS="$(nproc 2>/dev/null || echo 4)"
+
+mkdir -p "$OUT" "$BUILD"
+
+if [ "$(uname -m)" = "aarch64" ] || [ "$(uname -m)" = "arm64" ]; then
+	CROSS="${CROSS:-}"
+elif command -v aarch64-linux-gnu-g++ > /dev/null 2>&1; then
+	CROSS="${CROSS:-aarch64-linux-gnu-}"
+else
+	echo "error: no aarch64 toolchain found. Install g++-aarch64-linux-gnu or run on aarch64." >&2
+	exit 1
+fi
+
+if [ -z "${CC:-}" ]; then
+	if command -v "${CROSS}gcc-9" > /dev/null 2>&1; then
+		CC="${CROSS}gcc-9"
+	else
+		CC="${CROSS}gcc"
+	fi
+fi
+
+if [ -z "${CXX:-}" ]; then
+	if command -v "${CROSS}g++-9" > /dev/null 2>&1; then
+		CXX="${CROSS}g++-9"
+	else
+		CXX="${CROSS}g++"
+	fi
+fi
+
+#CMake does not search PATH for CMAKE_AR, so resolve it to an absolute path.
+if [ -z "${AR:-}" ]; then
+	AR="$(command -v "${CROSS}ar" 2>/dev/null || echo "${CROSS}ar")"
+fi
+#aarch64 glibc does not ship <sys/reg.h>. libmem's generic ptrace.c includes it
+#but uses nothing from it (the x86 register dump is commented out), so an empty
+#shim is enough to compile the generic helpers on arm64.
+mkdir -p "$BUILD/shim/sys"
+: > "$BUILD/shim/sys/reg.h"
+COMMON_FLAGS="-O2 -fPIC -D_GLIBCXX_USE_CXX11_ABI=0 -isystem $BUILD/shim"
+
+EXTRA_CMAKE=()
+if [ -n "$CROSS" ]; then
+	TOOLCHAIN_FILE="$BUILD/aarch64-toolchain.cmake"
+	cat > "$TOOLCHAIN_FILE" <<EOF
+set(CMAKE_SYSTEM_NAME Linux)
+set(CMAKE_SYSTEM_PROCESSOR aarch64)
+set(CMAKE_C_COMPILER "$CC")
+set(CMAKE_CXX_COMPILER "$CXX")
+set(CMAKE_AR "$AR")
+set(CMAKE_RANLIB "${CROSS}ranlib")
+set(CMAKE_FIND_ROOT_PATH "${SYSROOT:-/usr/${CROSS%-}}")
+set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
+set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
+set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
+EOF
+	EXTRA_CMAKE=(-DCMAKE_TOOLCHAIN_FILE="$TOOLCHAIN_FILE")
+fi
+
+echo "==> compiler: $CXX"
+echo "==> output:   $OUT"
+
+clone() {
+	local url="$1"
+	local dir="$2"
+	local ref="${3:-}"
+	if [ -d "$dir/.git" ]; then
+		# Keep existing checkouts on the pinned ref instead of silently using
+		# whatever happened to be cloned the first time.
+		if [ -n "$ref" ]; then
+			if [ "${#ref}" -eq 40 ]; then
+				#Fetch the commit explicitly; GitHub may not serve a raw SHA
+				#with --depth 1.
+				git -C "$dir" fetch origin "$ref"
+			else
+				git -C "$dir" fetch --depth 1 origin "$ref"
+			fi
+			git -C "$dir" checkout -q FETCH_HEAD
+		fi
+		return
+	fi
+
+	if [ -n "$ref" ]; then
+		if [ "${#ref}" -eq 40 ]; then
+			#Pinned commit (git clone --branch does not accept a raw commit).
+			git clone --no-checkout "$url" "$dir"
+			git -C "$dir" checkout -q "$ref"
+		else
+			git clone --depth 1 --branch "$ref" "$url" "$dir"
+		fi
+	else
+		git clone --depth 1 "$url" "$dir"
+	fi
+}
+
+cmake_lib() {
+	local src="$1"
+	local dir="$2"
+	shift 2
+	cmake -S "$src" -B "$dir" \
+		-DCMAKE_C_COMPILER="$CC" \
+		-DCMAKE_CXX_COMPILER="$CXX" \
+		-DCMAKE_AR="$AR" \
+		-DCMAKE_BUILD_TYPE=Release \
+		-DCMAKE_C_FLAGS="$COMMON_FLAGS" \
+		-DCMAKE_CXX_FLAGS="$COMMON_FLAGS -include cstdint" \
+		-DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
+		-DBUILD_SHARED_LIBS=OFF \
+		"$@"
+	cmake --build "$dir" --parallel "$JOBS"
+}
+
+# libmem (the vendored header matches 5.1.5). Its bundled static build contains
+# libmem, capstone, keystone and llvm, which is what the SLSsteam link needs.
+clone https://github.com/rdbo/libmem.git "$BUILD/libmem" "5.1.5"
+#libmem vendors capstone, keystone and vcvars-bash as submodules. Without them
+#the external project has no source directory and cmake fails.
+git -C "$BUILD/libmem" submodule update --init --recursive
+#Its Linux glob also picks the generic src/linux/ptrace/*.c, which is needed for
+#ptrace_attach/read/write/detach and friends; the <sys/reg.h> it includes is
+#covered by the shim above.
+cmake_lib "$BUILD/libmem" "$BUILD/libmem-build" \
+	${EXTRA_CMAKE[@]+"${EXTRA_CMAKE[@]}"} \
+	-DLIBMEM_ARCH=aarch64 \
+	-DLIBMEM_BUILD_STATIC=ON \
+	-DLIBMEM_BUILD_TESTS=OFF
+find "$BUILD/libmem-build" -name 'liblibmem.a' -exec cp -v {} "$OUT/" \;
+test -f "$OUT/liblibmem.a" || (echo "error: liblibmem.a was not produced" >&2; exit 1)
+
+# yaml-cpp 0.8.0. The vendored headers in include/yaml-cpp are 0.8.0 with the
+# FpToString call sites reduced to plain stream inserts, so the header and the
+# library API match exactly.
+clone https://github.com/jbeder/yaml-cpp.git "$BUILD/yaml-cpp" "f7320141120f720aecc4c32be25586e7da9eb978"
+cmake_lib "$BUILD/yaml-cpp" "$BUILD/yaml-cpp-build" \
+	${EXTRA_CMAKE[@]+"${EXTRA_CMAKE[@]}"} \
+	-DYAML_CPP_BUILD_TESTS=OFF \
+	-DYAML_CPP_BUILD_TOOLS=OFF
+find "$BUILD/yaml-cpp-build" -name 'libyaml-cpp.a' -exec cp -v {} "$OUT/" \;
+test -f "$OUT/libyaml-cpp.a" || (echo "error: libyaml-cpp.a was not produced" >&2; exit 1)
+
+# protobuf (headers in include/ are 3.15.3)
+clone https://github.com/protocolbuffers/protobuf.git "$BUILD/protobuf" "v3.15.3"
+cmake_lib "$BUILD/protobuf/cmake" "$BUILD/protobuf-build" \
+	${EXTRA_CMAKE[@]+"${EXTRA_CMAKE[@]}"} \
+	-Dprotobuf_BUILD_TESTS=OFF \
+	-Dprotobuf_BUILD_SHARED_LIBS=OFF \
+	-Dprotobuf_BUILD_PROTOC_BINARIES=OFF \
+	-DCMAKE_CXX_STANDARD=14
+find "$BUILD/protobuf-build" -name 'libprotobuf.a' -exec cp -v {} "$OUT/" \;
+test -f "$OUT/libprotobuf.a" || (echo "error: libprotobuf.a was not produced" >&2; exit 1)
+
+# LuaJIT (the client uses the 2.1 ABI). Pin a 2.1 commit instead of the moving
+# v2.1 branch so the resulting static library is reproducible.
+clone https://github.com/LuaJIT/LuaJIT.git "$BUILD/luajit" "a4c064539ea931274d407e1249b4bb575424a0f4"
+
+# LuaJIT prepends $(CROSS) to $(CC), $(TARGET_AR) and $(TARGET_LD). Pass the
+# concrete target tools instead and clear CROSS so a user-supplied compiler
+# (including a multi-word one) is used exactly as given.
+make -C "$BUILD/luajit" -j "$JOBS" \
+	CROSS= \
+	CC="$CC" HOST_CC="${HOST_CC:-cc}" \
+	STATIC_CC="$CC" DYNAMIC_CC="$CC -fPIC" \
+	TARGET_LD="$CC" TARGET_AR="$AR rcus" \
+	TARGET_STRIP="${CROSS}strip" \
+	XCFLAGS="-fPIC" \
+	BUILDMODE=static
+cp -v "$BUILD/luajit/src/libluajit.a" "$OUT/"
+test -f "$OUT/libluajit.a" || (echo "error: libluajit.a was not produced" >&2; exit 1)
+
+echo "==> done"
+ls -l "$OUT"
