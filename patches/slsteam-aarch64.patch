+++ b/src/feats/depotkey_hook.hpp
@@ -0,0 +1,15 @@
+#pragma once
+
+class CNetPacket;
+
+
+namespace DepotKey
+{
+	// Incoming CM protobuf path: substitute a cached key when Steam reports an
+	// error for a depot whose Lua key was imported. No body change otherwise.
+	void recvMsg(CNetPacket* pkt);
+
+	// Outgoing CM protobuf path: observation only. Kept as the symmetric hook
+	// point for request correlation/logging.
+	void sendMsg(CNetPacket* pkt);
+}
diff --git a/src/feats/depotkey_import.hpp b/src/feats/depotkey_import.hpp
new file mode 100644
index 0000000..56ce31b
--- /dev/null
+++ b/src/feats/depotkey_import.hpp
@@ -0,0 +1,92 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// Synchronized retryable gate for the Lua depot-key importer.
+//
+// The importer can be reached from an early startup path and again from the
+// config/file watcher. Serialize both; the one-shot gate is completed only
+// after the body returns successfully, so a missing prerequisite or an
+// exception leaves it retryable.
+//
+// Contract: `ready()` must validate the stplug-in directory (return false while
+// it is missing). `import()` may return void (success) or bool; a bool import
+// returning false leaves the gate uncompleted and retryable. Any other return
+// type is a compile error.
+
+#pragma once
+
+#include <mutex>
+#include <type_traits>
+
+
+namespace DepotKey
+{
+
+class LuaScriptImportGate
+{
+public:
+	template <typename Ready, typename Import>
+	bool run(Ready&& ready, Import&& import) noexcept
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		if (m_done) return false;
+
+		try
+		{
+			if (!ready()) return false;
+			if (!invokeImport(import)) return false;
+			m_done = true;
+			return true;
+		}
+		catch (...)
+		{
+			return false;
+		}
+	}
+
+	bool done() const noexcept
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		return m_done;
+	}
+
+	// Watcher-triggered imports deliberately run again after startup while
+	// retaining the same serialization boundary. They do not consume or reset
+	// the one-shot startup state.
+	template <typename Ready, typename Import>
+	bool rerun(Ready&& ready, Import&& import) noexcept
+	{
+		std::lock_guard<std::mutex> lock(m_mutex);
+		try
+		{
+			if (!ready()) return false;
+			return invokeImport(import);
+		}
+		catch (...)
+		{
+			return false;
+		}
+	}
+
+private:
+	template <typename Import>
+	static bool invokeImport(Import&& import)
+	{
+		if constexpr (std::is_void_v<std::invoke_result_t<Import>>)
+		{
+			import();
+			return true;
+		}
+		else
+		{
+			static_assert(
+				std::is_same_v<std::invoke_result_t<Import>, bool>,
+				"LuaScriptImportGate import() must return void or bool");
+			return import();
+		}
+	}
+
+	mutable std::mutex m_mutex;
+	bool m_done = false;
+};
+
+} // namespace DepotKey
diff --git a/src/feats/depotkey_scope.hpp b/src/feats/depotkey_scope.hpp
new file mode 100644
index 0000000..9437e68
--- /dev/null
+++ b/src/feats/depotkey_scope.hpp
@@ -0,0 +1,24 @@
+#pragma once
+
+#include <cstdint>
+
+
+namespace DepotKey
+{
+	// Should the manifest-store/download machinery engage for this depot?
+	// appIsAddedApp: appId is an AdditionalApp
+	// depotIsAddedApp: depotId itself is an AdditionalApp (workshop depots)
+	// depotKeyIsManaged: we injected a Lua key for this depot
+	// depotHasPin: an explicit manifest gid pin exists
+	// contentHasNativeLicense: Steam's native ownership says the app is owned
+	inline bool depotInManifestScope(bool appIsAddedApp,
+	                                 bool depotIsAddedApp,
+	                                 bool depotKeyIsManaged,
+	                                 bool depotHasPin,
+	                                 bool contentHasNativeLicense = false)
+	{
+		if (contentHasNativeLicense) return false;
+		if (depotHasPin) return true;
+		return appIsAddedApp || depotIsAddedApp || depotKeyIsManaged;
+	}
+}
