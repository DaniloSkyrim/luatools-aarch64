--- /dev/null
+++ b/src/feats/config_discovery.hpp
@@ -0,0 +1,128 @@
+#pragma once
+
+// Discovery helpers for the LuaTools-compatible app sources.
+//
+// The managed-app set comes from two places:
+//   * <Steam>/config/stplug-in/<appid>.lua - one script per MAIN app. The
+//     numeric filename stem is the authoritative app id; the addappid() and
+//     setManifestid() calls inside describe that app's depots/DLC and MUST NOT
+//     be treated as separate main apps.
+//   * ~/.config/SLSsteam/luaappids.yaml - explicit manual/plugin overrides.
+//
+// A main-app id is kept even when the same numeric id is also one of its own
+// content depots (single-depot titles such as No Man's Sky 275850). Filtering
+// on depot status would hide those games from the library entirely.
+//
+// The cap is a safety valve, not a library limit. A bulk copy of tens of
+// thousands of scripts makes Steam's package-0 reconciliation stall for
+// minutes; 4096 leaves normal libraries untouched and can be raised with
+// MaxManagedApps in config.yaml (0 disables it).
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+#include <unordered_set>
+#include <vector>
+
+
+namespace ConfigDiscovery
+{
+
+inline constexpr std::size_t kMaxManagedSourceApps = 4096;
+
+// Parse the app id encoded in a stplug-in script name. Returns 0 unless the
+// name is a purely numeric "<digits>.lua" that fits in uint32_t.
+inline uint32_t appIdFromScriptName(std::string_view filename)
+{
+	const auto dot = filename.rfind('.');
+	if (dot == std::string_view::npos) return 0;
+	if (filename.substr(dot) != ".lua") return 0;
+
+	const auto stem = filename.substr(0, dot);
+	if (stem.empty()) return 0;
+
+	uint64_t value = 0;
+	for (const char c : stem)
+	{
+		if (c < '0' || c > '9') return 0;
+		value = value * 10 + static_cast<uint64_t>(c - '0');
+		if (value > 0xFFFFFFFFull) return 0;
+	}
+
+	return static_cast<uint32_t>(value);
+}
+
+// A MAIN-app id from a filename stem or luaappids.yaml is authoritative.
+// `idIsAlsoManagedDepot` is deliberately ignored: single-depot titles reuse
+// the app id as their own content depot id.
+inline bool keepDiscoveredMainApp(uint32_t appId, bool idIsAlsoManagedDepot)
+{
+	(void)idIsAlsoManagedDepot;
+	return appId > 0;
+}
+
+// Recover ids that a racy directory scan dropped. The stplug-in directory is
+// written while Steam runs, so one directory_iterator pass can transiently
+// skip a still-present entry. `sourceExists(id)` confirms the specific file;
+// a genuinely deleted script is absent there and stays removed.
+template <typename SourceExistsFn>
+inline std::vector<uint32_t> recoverRacyScanDrops(
+    const std::unordered_set<uint32_t>& freshScan,
+    const std::unordered_set<uint32_t>& previouslyKnown,
+    SourceExistsFn sourceExists)
+{
+	std::vector<uint32_t> recovered;
+	for (const uint32_t appId : previouslyKnown)
+	{
+		if (appId == 0 || freshScan.contains(appId)) continue;
+		if (sourceExists(appId)) recovered.push_back(appId);
+	}
+	std::sort(recovered.begin(), recovered.end());
+	return recovered;
+}
+
+struct ManagedSourceSelection
+{
+	std::unordered_set<uint32_t> active;
+	std::size_t discovered = 0;
+	std::size_t ignored = 0;
+};
+
+// Pick the active managed set under `maxApps`.
+// Priority, highest first: luaappids.yaml, previously active ids that are
+// still discovered, then the remaining scripts. A bulk copy can therefore
+// never evict explicit overrides or a working session.
+inline ManagedSourceSelection selectManagedSources(
+    const std::unordered_set<uint32_t>& stplugApps,
+    const std::unordered_set<uint32_t>& luaYamlApps,
+    const std::unordered_set<uint32_t>& previouslyActive = {},
+    std::size_t maxApps = kMaxManagedSourceApps)
+{
+	ManagedSourceSelection result;
+	std::unordered_set<uint32_t> discovered = stplugApps;
+	discovered.insert(luaYamlApps.begin(), luaYamlApps.end());
+	result.discovered = discovered.size();
+	result.active.reserve(std::min(maxApps, result.discovered));
+
+	const auto addSorted = [&](const std::unordered_set<uint32_t>& candidates,
+	                           bool requireDiscovered) {
+		std::vector<uint32_t> sorted(candidates.begin(), candidates.end());
+		std::sort(sorted.begin(), sorted.end());
+		for (const uint32_t appId : sorted)
+		{
+			if (result.active.size() >= maxApps) break;
+			if (appId == 0 ||
+			    (requireDiscovered && !discovered.contains(appId))) continue;
+			result.active.insert(appId);
+		}
+	};
+
+	addSorted(luaYamlApps, false);
+	addSorted(previouslyActive, true);
+	addSorted(stplugApps, false);
+	result.ignored = result.discovered - result.active.size();
+	return result;
+}
+
+} // namespace ConfigDiscovery
