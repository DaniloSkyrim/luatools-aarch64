+bool MemHlp::isInText(const lm_module_t& module, const lm_address_t address)
+{
+	const Elf_Shdr* shText = Decompiler::getSection(module, ".text");
+	if (!shText)
+	{
+		return false;
+	}
+
+	const lm_address_t start = module.base + shText->rva;
+	return address >= start && address < start + shText->size;
+}
+
+bool MemHlp::getFunctionBounds(const lm_module_t& module, const lm_address_t address, lm_address_t* beginOut, lm_size_t* sizeOut)
+{
+#if SLS_ARCH_ARM64
+	FunctionBounds_t fn {};
+	if (!findFunctionBounds(module, address, fn))
+	{
+		return false;
+	}
+
+	if (beginOut)
+	{
+		*beginOut = fn.begin;
+	}
+
+	if (sizeOut)
+	{
+		*sizeOut = fn.size;
+	}
+
+	return true;
+#else
+	//Only the native arm64 client is checked against its unwind table
+	(void)module;
+	(void)address;
+	(void)beginOut;
+	(void)sizeOut;
+	return false;
+#endif
+}
