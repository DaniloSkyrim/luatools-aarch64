+std::string CConfig::findSteamRoot()
+{
+	// The loaded module path identifies the tree this session really runs from:
+	// ubuntu12_32 for the legacy client, steamrt64 for the new x86_64 client and
+	// steamrtarm64 for the native ARM64 client. It is not available during the
+	// first config load, so the HOME candidates below remain the fallback.
+	if (g_modSteamClient && g_modSteamClient->path && *g_modSteamClient->path)
+	{
+		std::error_code ec;
+		const std::filesystem::path module(g_modSteamClient->path);
+		const auto root = module.parent_path().parent_path();
+		if (!root.empty() &&
+		    std::filesystem::is_directory(root / "config", ec) && !ec)
+		{
+			return root.string();
+		}
+	}
+
+	const auto looksLikeRoot = [](const std::filesystem::path& root) {
+		std::error_code ec;
+		if (std::filesystem::is_directory(root / "config", ec) && !ec)
+		{
+			return true;
+		}
+		ec.clear();
+		return std::filesystem::exists(root / "steam.sh", ec) && !ec;
+	};
+
+	// Steam's launcher exports STEAMROOT. Honour it before guessing: custom
+	// installs and SteamOS images do not always expose steam.sh at the root.
+	const char* envRoots[] = { "STEAMROOT", "STEAM_ROOT" };
+	for (const char* name : envRoots)
+	{
+		const char* value = getenv(name);
+		if (value && *value && looksLikeRoot(value))
+		{
+			return value;
+		}
+	}
+
+	const char* home = getenv("HOME");
+	if (!home)
+	{
+		return "";
+	}
+
+	const char* xdgData = getenv("XDG_DATA_HOME");
+	const std::filesystem::path candidates[] = {
+		std::filesystem::path(home) / ".steam/steam",
+		std::filesystem::path(home) / ".steam/root",
+		std::filesystem::path(home) / ".steam/debian-installation",
+		xdgData && *xdgData
+			? std::filesystem::path(xdgData) / "Steam"
+			: std::filesystem::path(home) / ".local/share/Steam",
+	};
+
+	for (const auto& candidate : candidates)
+	{
+		if (looksLikeRoot(candidate))
+		{
+			return candidate.string();
+		}
+	}
+
+	return "";
+}
+
+// The stplug-in scripts are the primary add-game source used by LuaTools. Only
+// the numeric filename stem names a MAIN app; the addappid()/setManifestid()
+// calls inside describe its depots/DLC and must not become main apps. Parsing
+// those bodies (depot keys, manifest pins) is a separate phase and is not done
+// here yet.
+std::unordered_set<AppId_t> CConfig::discoverStPluginAppIds()
+{
+	std::unordered_set<AppId_t> result;
+
+	const auto steamRoot = findSteamRoot();
+	if (steamRoot.empty())
+	{
+		return result;
+	}
+
+	const std::filesystem::path stplug =
+		std::filesystem::path(steamRoot) / "config" / "stplug-in";
+
+	std::error_code ec;
+	if (!std::filesystem::is_directory(stplug, ec) || ec)
+	{
+		return result;
+	}
+
+	std::filesystem::directory_iterator it(
+		stplug,
+		std::filesystem::directory_options::skip_permission_denied,
+		ec);
+	if (ec)
+	{
+		return result;
+	}
+
+	const std::filesystem::directory_iterator end;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		if (!entry.is_regular_file(entryEc) || entryEc)
+		{
+			it.increment(ec);
+			if (ec) break;
+			continue;
+		}
+
+		const AppId_t appId =
+			ConfigDiscovery::appIdFromScriptName(entry.path().filename().string());
+		if (ConfigDiscovery::keepDiscoveredMainApp(appId, false))
+		{
+			result.insert(appId);
+		}
+
+		it.increment(ec);
+		if (ec)
+		{
+			// An I/O error mid-walk is not a removal signal. Keep what was
+			// collected and let the recovery pass re-confirm known ids.
+			LOG_CUSTOM(k_ELogLevelWarn | k_ELogLevelOnce,
+				"stplug-in scan stopped early: %s\n", ec.message().c_str());
+			break;
+		}
+	}
+
+	// The plugin writes <id>.lua while Steam runs, so one scan can race a
+	// rename. Re-confirm each apparent drop against its file so a short scan is
+	// not mistaken for a removal.
+	for (const AppId_t appId : ConfigDiscovery::recoverRacyScanDrops(
+	         result, addedAppIds.copy(),
+	         [&](uint32_t id) {
+		         std::error_code fileEc;
+		         return std::filesystem::exists(
+		                    stplug / (std::to_string(id) + ".lua"), fileEc) &&
+		                !fileEc;
+	         }))
+	{
+		result.insert(appId);
+	}
+
+	return result;
+}
+
+// luaappids.yaml is authored by the user or by the plugin. It is read-only
+// here; the discovered set is never mirrored back into it.
+std::unordered_set<AppId_t> CConfig::loadLuaAppIdsYaml()
+{
+	std::unordered_set<AppId_t> result;
+
+	const auto path = getLuaAppIdsPath();
+
+	std::error_code ec;
+	if (!std::filesystem::exists(path, ec) || ec)
+	{
+		return result;
+	}
+
+	try
+	{
+		const YAML::Node node = YAML::LoadFile(path.string());
+		if (!node || !node["AdditionalApps"])
+		{
+			return result;
+		}
+
+		for (const auto& subNode : node["AdditionalApps"])
+		{
+			const AppId_t appId = subNode.as<AppId_t>();
+			if (ConfigDiscovery::keepDiscoveredMainApp(appId, false))
+			{
+				result.insert(appId);
+			}
+		}
+	}
+	catch (...)
+	{
+		LOG_CUSTOM(k_ELogLevelWarn | k_ELogLevelOnce,
+			"Failed to parse %s\n", path.c_str());
+	}
+
+	return result;
+}
