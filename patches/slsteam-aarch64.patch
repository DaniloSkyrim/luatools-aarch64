+std::string trim(const std::string& text)
+{
+	const auto first = text.find_first_not_of(" \t\r\n");
+	if (first == std::string::npos) return {};
+	const auto last = text.find_last_not_of(" \t\r\n");
+	return text.substr(first, last - first + 1);
+}
+
+bool parseU32(const std::string& text, uint32_t& out)
+{
+	if (text.empty()) return false;
+	unsigned long long value = 0;
+	const auto result = std::from_chars(
+		text.data(), text.data() + text.size(), value);
+	if (result.ec != std::errc{} ||
+	    result.ptr != text.data() + text.size() ||
+	    value > 0xFFFFFFFFull)
+	{
+		return false;
+	}
+	out = static_cast<uint32_t>(value);
+	return true;
+}
+
+std::string unquote(const std::string& value)
+{
+	if (value.size() >= 2)
+	{
+		const char first = value.front();
+		const char last = value.back();
+		if ((first == '"' && last == '"') || (first == '\'' && last == '\''))
+		{
+			return value.substr(1, value.size() - 2);
+		}
+	}
+	return value;
+}
+
+bool parseCatalogFile(const std::string& path, SavedKey& out)
+{
+	std::ifstream input(path.c_str());
+	if (!input.is_open()) return false;
+
+	SavedKey parsed;
+	std::string line;
+	while (std::getline(input, line))
+	{
+		const auto comment = line.find('#');
+		if (comment != std::string::npos) line.erase(comment);
+		line = trim(line);
+		if (line.empty() || line == "---") continue;
+
+		const auto separator = line.find(':');
+		if (separator == std::string::npos) continue;
+		const auto name = trim(line.substr(0, separator));
+		const auto value = unquote(trim(line.substr(separator + 1)));
+
+		if (name == "appId")
+		{
+			parseU32(value, parsed.appId);
+		}
+		else if (name == "depotId")
+		{
+			parseU32(value, parsed.depotId);
+		}
+		else if (name == "key")
+		{
+			parsed.key = base64Decode(value);
+		}
+		else if (name == "managed")
+		{
+			parsed.managed = value == "true" || value == "yes" || value == "1";
+		}
+	}
+
+	if (parsed.depotId == 0 || parsed.key.size() != 32) return false;
+	out = std::move(parsed);
+	return true;
+}
+
+bool writeAtomic(const std::string& path, const std::string& data)
+{
+	const std::filesystem::path target(path);
+	std::error_code ec;
+	std::filesystem::create_directories(target.parent_path(), ec);
+	if (ec) return false;
+
+	const std::string temp = path + ".tmp";
+	{
+		std::ofstream output(temp.c_str(),
+		                     std::ios::out | std::ios::trunc | std::ios::binary);
+		if (!output.is_open()) return false;
+		output.write(data.data(), static_cast<std::streamsize>(data.size()));
+		if (!output.good())
+		{
+			output.close();
+			std::filesystem::remove(temp, ec);
+			return false;
+		}
+	}
+
+	std::filesystem::rename(temp, target, ec);
+	if (ec)
+	{
+		std::filesystem::remove(temp, ec);
+		return false;
+	}
+	return true;
+}
+
+} // namespace
+
+
+std::string keyDir(const std::string& configDir)
+{
+	if (configDir.empty()) return {};
+	return configDir + "/cache";
+}
+
+std::string keyPath(const std::string& configDir, uint32_t depotId)
+{
+	const auto dir = keyDir(configDir);
+	if (dir.empty() || depotId == 0) return {};
+	return dir + "/depotkey_" + std::to_string(depotId) + ".yaml";
+}
+
+std::string hexToBytes(const std::string& hex)
+{
+	if (hex.size() != 64) return {};
+
+	const auto nibble = [](char c) -> int {
+		if (c >= '0' && c <= '9') return c - '0';
+		if (c >= 'a' && c <= 'f') return 10 + (c - 'a');
+		if (c >= 'A' && c <= 'F') return 10 + (c - 'A');
+		return -1;
+	};
+
+	std::string out;
+	out.reserve(32);
+	for (std::size_t i = 0; i < hex.size(); i += 2)
+	{
+		const int high = nibble(hex[i]);
+		const int low = nibble(hex[i + 1]);
+		if (high < 0 || low < 0) return {};
+		out.push_back(static_cast<char>((high << 4) | low));
+	}
+	return out;
+}
+
+std::string base64Encode(const std::string& bytes)
+{
+	static const char table[] =
+		"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+	std::string out;
+	int value = 0;
+	int bits = -6;
+	for (const unsigned char byte : bytes)
+	{
+		value = (value << 8) + byte;
+		bits += 8;
+		while (bits >= 0)
+		{
+			out.push_back(table[(value >> bits) & 0x3F]);
+			bits -= 6;
+		}
+	}
+	if (bits > -6)
+	{
+		out.push_back(table[((value << 8) >> (bits + 8)) & 0x3F]);
+	}
+	while (out.size() % 4) out.push_back('=');
+	return out;
+}
+
+std::string base64Decode(const std::string& text)
+{
+	const auto valueOf = [](char c) -> int {
+		if (c >= 'A' && c <= 'Z') return c - 'A';
+		if (c >= 'a' && c <= 'z') return 26 + (c - 'a');
+		if (c >= '0' && c <= '9') return 52 + (c - '0');
+		if (c == '+') return 62;
+		if (c == '/') return 63;
+		return -1;
+	};
+
+	std::string out;
+	int value = 0;
+	int bits = -8;
+	for (const char c : text)
+	{
+		if (c == '=') break;
+		if (c == '\n' || c == '\r' || c == ' ' || c == '\t') continue;
+		const int digit = valueOf(c);
+		if (digit < 0) return {};
+		value = (value << 6) | digit;
+		bits += 6;
+		if (bits >= 0)
+		{
+			out.push_back(static_cast<char>((value >> bits) & 0xFF));
+			bits -= 8;
+		}
+	}
+	return out;
+}
+
+SavedKey getKey(const std::string& configDir, uint32_t depotId)
+{
+	SavedKey key;
+	const auto path = keyPath(configDir, depotId);
+	if (path.empty()) return key;
+	if (!parseCatalogFile(path, key)) return {};
+	if (key.depotId != depotId) return {};
+	return key;
+}
+
+bool saveKey(const std::string& configDir, uint32_t appId, uint32_t depotId,
+             const std::string& key, bool managed)
+{
+	if (depotId == 0 || key.size() != 32) return false;
+
+	std::lock_guard<std::mutex> lock(g_writeMu);
+
+	SavedKey existing;
+	const auto path = keyPath(configDir, depotId);
+	if (path.empty()) return false;
+	parseCatalogFile(path, existing);
+
+	const uint32_t finalAppId = appId ? appId : existing.appId;
+	const bool finalManaged = existing.managed || managed;
+	if (existing.depotId == depotId && existing.key == key &&
+	    existing.appId == finalAppId && existing.managed == finalManaged)
+	{
+		return true;
+	}
+
+	std::ostringstream yaml;
+	yaml << "appId: " << finalAppId << '\n';
+	yaml << "depotId: " << depotId << '\n';
+	yaml << "key: " << base64Encode(key) << '\n';
+	yaml << "managed: " << (finalManaged ? "true" : "false") << '\n';
+	return writeAtomic(path, yaml.str());
+}
+
+bool isManagedDepot(const std::string& configDir, uint32_t depotId)
+{
+	const auto key = getKey(configDir, depotId);
+	return key.managed && key.key.size() == 32;
+}
+
+std::vector<uint32_t> managedDepotsForApp(const std::string& configDir,
+                                          uint32_t appId)
+{
+	std::vector<uint32_t> out;
+	if (appId == 0) return out;
+
+	const auto dir = keyDir(configDir);
+	std::error_code ec;
+	if (!std::filesystem::is_directory(dir, ec) || ec) return out;
+
+	std::filesystem::directory_iterator it(
+		dir, std::filesystem::directory_options::skip_permission_denied, ec);
+	const std::filesystem::directory_iterator end;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		if (entry.is_regular_file(entryEc) && !entryEc)
+		{
+			SavedKey key;
+			if (parseCatalogFile(entry.path().string(), key) &&
+			    key.managed && key.appId == appId)
+			{
+				out.push_back(key.depotId);
+			}
+		}
+
+		it.increment(ec);
+		if (ec) break;
+	}
+
+	std::sort(out.begin(), out.end());
+	out.erase(std::unique(out.begin(), out.end()), out.end());
+	return out;
+}
+
+void purgeDepot(const std::string& configDir, uint32_t depotId)
+{
+	const auto path = keyPath(configDir, depotId);
+	if (path.empty()) return;
+
+	std::lock_guard<std::mutex> lock(g_writeMu);
+	std::error_code ec;
+	std::filesystem::remove(path, ec);
+}
+
+ImportResult importLuaScriptsDetailed(
+	const std::string& configDir, const std::string& stplugDir,
+	const std::unordered_set<uint32_t>& managedApps)
+{
+	ImportResult result;
+	if (managedApps.empty()) return result;
+
+	std::error_code ec;
+	if (!std::filesystem::is_directory(stplugDir, ec) || ec) return result;
+
+	static const std::regex addAppIdWithKey(
+		"addappid\\s*\\(\\s*(\\d+)\\s*,\\s*\\d+\\s*,\\s*\"([0-9A-Fa-f]{64})\""
+		"\\s*(?:,\\s*[^)]*)?\\)"
+	);
+
+	std::filesystem::directory_iterator it(
+		stplugDir, std::filesystem::directory_options::skip_permission_denied, ec);
+	const std::filesystem::directory_iterator end;
+	bool scanOk = true;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		const bool regular = entry.is_regular_file(entryEc);
+		if (entryEc)
+		{
+			scanOk = false;
+		}
+		else if (regular && entry.path().extension().string() == ".lua")
+		{
+			const uint32_t appId =
+				ConfigDiscovery::appIdFromScriptName(entry.path().filename().string());
+			if (appId != 0 && managedApps.contains(appId))
+			{
+				std::ifstream input(entry.path());
+				if (!input.is_open())
+				{
+					scanOk = false;
+				}
+				else
+				{
+					std::string line;
+					while (std::getline(input, line))
+					{
+						const auto comment = line.find("--");
+						if (comment != std::string::npos) line.erase(comment);
+
+						auto begin = std::sregex_iterator(
+							line.begin(), line.end(), addAppIdWithKey);
+						const auto finish = std::sregex_iterator();
+						for (auto match = begin; match != finish; ++match)
+						{
+							uint32_t depotId = 0;
+							if (!parseU32((*match)[1].str(), depotId)) continue;
+							result.depots.insert(depotId);
+
+							const auto key = hexToBytes((*match)[2].str());
+							if (key.size() != 32) continue;
+							if (saveKey(configDir, appId, depotId, key, true))
+							{
+								++result.imported;
+							}
+						}
+					}
+					if (input.bad()) scanOk = false;
+				}
+			}
+		}
+
+		it.increment(ec);
+		if (ec)
+		{
+			scanOk = false;
+			break;
+		}
+	}
+
+	result.complete = scanOk;
+	return result;
+}
+
+std::size_t importLuaScripts(const std::string& configDir,
+                             const std::string& stplugDir,
+                             const std::unordered_set<uint32_t>& managedApps)
+{
+	return importLuaScriptsDetailed(configDir, stplugDir, managedApps).imported;
+}
+
+void pruneOrphans(const std::string& configDir,
+                  const std::unordered_set<uint32_t>& keepDepots)
+{
+	const auto dir = keyDir(configDir);
+	if (dir.empty()) return;
+
+	std::error_code ec;
+	if (!std::filesystem::is_directory(dir, ec) || ec) return;
+
+	static const std::regex fileRe("depotkey_(\\d+)\\.yaml");
+
+	std::lock_guard<std::mutex> lock(g_writeMu);
+	std::filesystem::directory_iterator it(
+		dir, std::filesystem::directory_options::skip_permission_denied, ec);
+	const std::filesystem::directory_iterator end;
+	while (it != end)
+	{
+		const auto& entry = *it;
+		std::error_code entryEc;
+		if (entry.is_regular_file(entryEc) && !entryEc &&
+		    std::regex_match(entry.path().filename().string(), fileRe))
+		{
+			SavedKey key;
+			if (parseCatalogFile(entry.path().string(), key) &&
+			    key.managed && !keepDepots.contains(key.depotId))
+			{
+				std::error_code removeEc;
+				std::filesystem::remove(entry.path(), removeEc);
+			}
+		}
+
+		it.increment(ec);
+		if (ec) break;
+	}
+}
+
+} // namespace DepotKey
diff --git a/src/feats/depotkey_catalog.hpp b/src/feats/depotkey_catalog.hpp
new file mode 100644
index 0000000..e0f8afd
--- /dev/null
+++ b/src/feats/depotkey_catalog.hpp
@@ -0,0 +1,111 @@
+// SPDX-License-Identifier: AGPL-3.0-only
+//
+// Depot decryption key catalog (standalone, no client SDK/hooks).
+//
+// LuaTools scripts in <Steam>/config/stplug-in carry depot keys in the
+// community format:
+//
+//     addappid(<depotId>, 1, "<64 hex chars>")
+//
+// This catalog persists those keys under
+// <configDir>/cache/depotkey_<depotId>.yaml:
+//
+//     appId: <uint32>
+//     depotId: <uint32>
+//     key: <base64(32 bytes)>
+//     managed: true|false
+//
+// `managed` is sticky: a later passive observation of the same depot must not
+// downgrade a Lua-injected key out of manifest scope. The catalog is pure file
+// I/O; the caller supplies the SLSsteam config dir and the stplug-in dir.
+
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <unordered_set>
+#include <vector>
+
+
+namespace DepotKey
+{
+
+struct SavedKey
+{
+	uint32_t appId = 0;
+	uint32_t depotId = 0;
+	std::string key; // raw 32 bytes (binary, not hex)
+	bool managed = false;
+};
+
+// <configDir>/cache. Does not create anything.
+std::string keyDir(const std::string& configDir);
+
+// <configDir>/cache/depotkey_<depotId>.yaml.
+std::string keyPath(const std::string& configDir, uint32_t depotId);
+
+// Empty SavedKey when absent, unreadable, or when the file names another
+// depot (a renamed/corrupt catalog never leaks another depot's key).
+SavedKey getKey(const std::string& configDir, uint32_t depotId);
+
+// Writes atomically (temp + rename). `key` must be exactly 32 bytes.
+// appId == 0 keeps the previous appId; managed is merged as sticky.
+bool saveKey(const std::string& configDir, uint32_t appId, uint32_t depotId,
+             const std::string& key, bool managed);
+
+// True iff a valid 32-byte key exists and is marked managed.
+bool isManagedDepot(const std::string& configDir, uint32_t depotId);
+
+// Every managed depot whose catalog entry records `appId`.
+std::vector<uint32_t> managedDepotsForApp(const std::string& configDir,
+                                          uint32_t appId);
+
+// Remove one catalog entry (LuaTools remove-game / depot pruning).
+void purgeDepot(const std::string& configDir, uint32_t depotId);
+
+// 64 hex chars -> 32 raw bytes; empty on malformed input.
+std::string hexToBytes(const std::string& hex);
+
+// Minimal base64 for the fixed 32-byte key payload.
+std::string base64Encode(const std::string& bytes);
+std::string base64Decode(const std::string& text);
+
+// Scan <stplugDir>/*.lua, strip `--` comments, and ingest every
+// addappid(depot, <n>, "<64 hex>"[, ...]) whose filename stem is in
+// `managedApps`. `managedApps` is required: an empty set imports nothing (the
+// caller passes the config's managed ids). Directory I/O errors end the scan
+// without discarding keys already imported. The accepted script format is the
+// community one; the key must be quoted 64-char hex.
+struct ImportResult
+{
+	std::size_t imported = 0;
+	// True only when the whole stplug-in scan finished without an I/O error
+	// (and managedApps was non-empty and the directory existed). Callers must
+	// gate pruneOrphans() on this: a partial scan would delete valid catalogs.
+	bool complete = false;
+	// Depots referenced by the current scripts, including ones whose save
+	// failed. Pass this to pruneOrphans() after a complete import.
+	std::unordered_set<uint32_t> depots;
+};
+
+ImportResult importLuaScriptsDetailed(const std::string& configDir,
+                                      const std::string& stplugDir,
+                                      const std::unordered_set<uint32_t>& managedApps);
+
+// Compatibility wrapper returning only the accepted-key count.
+std::size_t importLuaScripts(const std::string& configDir,
+                             const std::string& stplugDir,
+                             const std::unordered_set<uint32_t>& managedApps);
+
+// Remove MANAGED catalog entries whose depot is not in `keepDepots`. This
+// reconciles a script deleted while Steam was closed: the on-disk catalog is
+// otherwise never revisited by the per-app relation index, which starts empty
+// each process. Observed (managed=false) keys are left alone.
+// The caller must only call this after ImportResult::complete is true; with an
+// empty managedApps or a missing stplug-in directory the import is incomplete
+// and prune would delete everything.
+void pruneOrphans(const std::string& configDir,
+                  const std::unordered_set<uint32_t>& keepDepots);
+
+} // namespace DepotKey
diff --git a/src/feats/depotkey_hook.cpp b/src/feats/depotkey_hook.cpp
new file mode 100644
index 0000000..40bd64b
--- /dev/null
+++ b/src/feats/depotkey_hook.cpp
@@ -0,0 +1,75 @@
+#include "depotkey_hook.hpp"
+
+#include "../config.hpp"
+#include "../log.hpp"
+#include "../sdk/CNetPacket.hpp"
+
+#include "depotkey_catalog.hpp"
+
+
+namespace DepotKey
+{
+
+void recvMsg(CNetPacket* pkt)
+{
+	if (!pkt || !pkt->isValid() || !pkt->isProtoBuf())
+	{
+		return;
+	}
+
+	if (pkt->getProtoBufType() != k_EMsgClientGetDepotDecryptionKeyResponse)
+	{
+		return;
+	}
+
+	auto body = pkt->deserializeBody<CMsgClientGetDepotDecryptionKeyResponse>();
+	if (body.depot_id() == 0)
+	{
+		return;
+	}
+
+	const auto configDir = g_config.getDir().string();
+	if (configDir.empty())
+	{
+		return;
+	}
+
+	const auto saved = getKey(configDir, body.depot_id());
+	if (body.eresult() != k_EResultOK)
+	{
+		if (saved.key.size() == 32)
+		{
+			body.set_eresult(k_EResultOK);
+			body.set_depot_encryption_key(saved.key);
+
+			const auto header = pkt->deserializeHeader();
+			pkt->serialize(body, &header);
+			LOG_DEBUG("DepotKey: substituted cached key for depot %u\n",
+				body.depot_id());
+		}
+	}
+	else if (body.depot_encryption_key().size() == 32 && saved.key.empty())
+	{
+		saveKey(configDir, 0, body.depot_id(),
+			body.depot_encryption_key(), false);
+	}
+}
+
+void sendMsg(CNetPacket* pkt)
+{
+	if (!pkt || !pkt->isValid() || !pkt->isProtoBuf())
+	{
+		return;
+	}
+
+	if (pkt->getProtoBufType() != k_EMsgClientGetDepotDecryptionKey)
+	{
+		return;
+	}
+
+	const auto body = pkt->deserializeBody<CMsgClientGetDepotDecryptionKey>();
+	LOG_DEBUG("DepotKey: outgoing request app=%u depot=%u\n",
+		body.app_id(), body.depot_id());
+}
+
+} // namespace DepotKey
diff --git a/src/feats/depotkey_hook.hpp b/src/feats/depotkey_hook.hpp
new file mode 100644
index 0000000..d9161d4
