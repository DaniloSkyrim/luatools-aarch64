+
+static bool isArmRegister(const std::string& str)
+{
+	if (str.size() < 2 || str[0] != 'x')
+	{
+		return false;
+	}
+
+	return std::all_of(str.begin() + 1, str.end(), [](const unsigned char c) { return std::isdigit(c); });
+}
+
+static bool parseArmImmediate(const std::string& str, lm_address_t& value)
+{
+	std::string imm = trimArmOperand(str);
+	if (imm.empty())
+	{
+		return false;
+	}
+
+	if (imm[0] == '#')
+	{
+		imm.erase(0, 1);
+	}
+
+	bool negative = false;
+	if (!imm.empty() && imm[0] == '-')
+	{
+		negative = true;
+		imm.erase(0, 1);
+	}
+
+	if (imm.size() > 2 && imm[0] == '0' && (imm[1] == 'x' || imm[1] == 'X'))
