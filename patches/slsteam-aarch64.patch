+					if
+					(
+						fieldSize
+						&& readEncoded(cursor, encoding, mod.base, true, pcBegin)
+						&& readEncoded(cursor + fieldSize, encoding & 0x0F, mod.base, false, pcRange)
+						&& pcRange > 0
+						&& target >= static_cast<lm_address_t>(pcBegin)
+						&& target < static_cast<lm_address_t>(pcBegin + pcRange)
+					)
+					{
+						out.begin = static_cast<lm_address_t>(pcBegin);
+						out.size = static_cast<lm_size_t>(pcRange);
+						return true;
+					}
+				}
+			}
+
+			record = next;
+		}
+
+		return false;
+	}
+}
