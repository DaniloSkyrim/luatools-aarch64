+#if SLS_ARCH_ARM64
+namespace
+{
+	struct FunctionBounds_t
+	{
+		lm_address_t begin;
+		lm_size_t size;
+	};
+
+	template<typename T>
+	T readAt(const lm_address_t address)
+	{
+		T value;
+		memcpy(&value, reinterpret_cast<const void*>(address), sizeof(T));
+		return value;
+	}
+
+	uint64_t readULEB(lm_address_t& cursor)
+	{
+		uint64_t value = 0;
+		unsigned int shift = 0;
+
+		while (true)
+		{
+			const uint8_t byte = readAt<uint8_t>(cursor++);
+			if (shift < 64)
+			{
+				value |= static_cast<uint64_t>(byte & 0x7F) << shift;
+			}
+
+			shift += 7;
+			if (!(byte & 0x80))
+			{
+				return value;
+			}
+		}
+	}
+
+	void skipSLEB(lm_address_t& cursor)
+	{
+		while (readAt<uint8_t>(cursor++) & 0x80) { }
+	}
+
+	//Byte size of a DW_EH_PE value, 0 when the format is not a fixed size one
+	unsigned int encodedSize(const uint8_t encoding)
+	{
+		switch (encoding & 0x0F)
+		{
+			case 0x00: //absptr
+			case 0x04: //udata8
+			case 0x0C: //sdata8
+				return 8;
+			case 0x02: //udata2
+			case 0x0A: //sdata2
+				return 2;
+			case 0x03: //udata4
+			case 0x0B: //sdata4
+				return 4;
+		}
+
+		return 0;
+	}
+
+	///isAddress is false for sizes, which are never pc relative or rebased
+	bool readEncoded(const lm_address_t field, const uint8_t encoding, const lm_address_t moduleBase, const bool isAddress, int64_t& out)
+	{
+		if (encoding == 0xFF || (encoding & 0x70) > 0x10) //omit, or datarel/textrel/funcrel/aligned
+		{
+			return false;
+		}
+
+		switch (encoding & 0x0F)
+		{
+			case 0x00:
+			case 0x04:
+				out = static_cast<int64_t>(readAt<uint64_t>(field));
+				break;
+			case 0x0C:
+				out = readAt<int64_t>(field);
+				break;
+			case 0x02:
+				out = readAt<uint16_t>(field);
+				break;
+			case 0x0A:
+				out = readAt<int16_t>(field);
+				break;
+			case 0x03:
+				out = readAt<uint32_t>(field);
+				break;
+			case 0x0B:
+				out = readAt<int32_t>(field);
+				break;
+			default:
+				return false;
+		}
+
+		if (!isAddress)
+		{
+			return true;
+		}
+
+		if (encoding & 0x10) //pcrel
+		{
+			out += static_cast<int64_t>(field);
+		}
+		else if ((encoding & 0x0F) == 0x00)
+		{
+			//Absolute values are link time addresses and the module is not relocated yet
+			out += static_cast<int64_t>(moduleBase);
+		}
+
+		return true;
+	}
+
+	///Finds the unwind record covering target. Every function of the native
+	///client has one, so this gives its real entry point and size, which a byte
+	///pattern alone cannot.
+	bool findFunctionBounds(const lm_module_t& mod, const lm_address_t target, FunctionBounds_t& out)
+	{
+		const Elf_Shdr* shEh = Decompiler::getSection(mod, ".eh_frame");
+		if (!shEh || shEh->size < 8)
+		{
+			return false;
+		}
+
+		const lm_address_t start = mod.base + shEh->rva;
+		const lm_address_t end = start + shEh->size;
+		if (end > mod.end)
+		{
+			return false;
+		}
+
+		//CIE record address -> pointer encoding of its FDEs
+		std::unordered_map<lm_address_t, uint8_t> cies;
+
+		lm_address_t record = start;
+		while (record + 8 <= end)
+		{
+			uint64_t length = readAt<uint32_t>(record);
+			if (length == 0) //Terminator
+			{
+				break;
+			}
+
+			lm_address_t cursor = record + 4;
+			if (length == 0xFFFFFFFF)
+			{
+				length = readAt<uint64_t>(cursor);
+				cursor += 8;
+			}
+
+			const lm_address_t next = cursor + length;
+			if (next > end || next <= record)
+			{
+				break;
+			}
+
+			const lm_address_t idField = cursor;
+			const uint32_t id = readAt<uint32_t>(idField);
+			cursor += 4;
+
+			if (id == 0)
+			{
+				//CIE
+				const uint8_t version = readAt<uint8_t>(cursor++);
+
+				const char* augmentation = reinterpret_cast<const char*>(cursor);
+				cursor += strnlen(augmentation, next - cursor) + 1;
+
+				if (version >= 4)
+				{
+					cursor += 2; //address_size, segment_selector_size
+				}
+
+				readULEB(cursor); //code alignment
+				skipSLEB(cursor); //data alignment
+				//return address register
+				if (version == 1)
+				{
+					cursor++;
+				}
+				else
+				{
+					readULEB(cursor);
+				}
+
+				uint8_t fdeEncoding = 0;
+				if (augmentation[0] == 'z')
+				{
+					const uint64_t augLength = readULEB(cursor);
+					lm_address_t aug = cursor;
+
+					for (const char* c = augmentation + 1; *c; c++)
+					{
+						if (*c == 'R')
+						{
+							fdeEncoding = readAt<uint8_t>(aug++);
+						}
+						else if (*c == 'L')
+						{
+							aug++;
+						}
+						else if (*c == 'P')
+						{
+							const uint8_t personalityEnc = readAt<uint8_t>(aug++);
+							aug += encodedSize(personalityEnc);
+						}
+					}
+
+					cursor += augLength;
+				}
+
+				cies[record] = fdeEncoding;
